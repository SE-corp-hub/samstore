// SAM STORE — Prisma schema (Thin Slice + roles/tenancy day one)
// Rule from AGENTS.md: EVERY store-owned table carries store_id.
// Money is stored as integer minor units (cents) — never floats.
// Naming: camelCase fields (Prisma), no @map; revisit with a dedicated mapping pass.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum StoreStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  CLOSED
}

enum LinkStatus {
  ACTIVE
  REVOKED
  ROTATED
}

// M3: explicit fulfillment — replaces address inference (backfilled; the app
// writes it at order creation; reads switch in Module 8).
enum OrderFulfillmentType {
  PICKUP
  DELIVERY
}

enum CartStatus {
  OPEN
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  ON_HOLD // POS held order (V1) — goods earmarked, resume/edit/complete later
  COMPLETED // counter/POS sale — terminal, payment captured at completion
  CANCELLED
  FAILED_DELIVERY
}

/// How an ONLINE order's checkout reservation was settled. Null while the
/// reservation is still held (in flight), then exactly one terminal value:
/// CONSUMED = fulfilled (on-hand + reserved both fell), RELEASED = cancelled
/// (reserved only fell; the units stayed on the shelf). POS/pre-order sales
/// consume on-hand at sale time and never carry a reservation, so they stay null.
enum OrderStockDisposition {
  CONSUMED
  RELEASED
}

enum PaymentStatus {
  PENDING // COD: awaiting collection at delivery
  RECEIVED // P4: gateway notification or bank-transfer proof received (awaiting review)
  COLLECTED // COD: collected
  REVIEWED // P4: operator reviewed the proof / gateway payment confirmed
  CANCELLED_REFUND // unused in slice; reserved
  REFUNDED // P4: fully refunded
  FAILED // P4: gateway payment failed
}

enum PlatformRole {
  PLATFORM_ADMIN
}

enum StoreRole {
  OWNER
  MANAGER
  STAFF
  SALES_AGENT
  DELIVERY // P12: courier — sees OUT_FOR_DELIVERY orders only; no admin surfaces
}

enum MembershipStatus {
  PENDING
  ACTIVE
  DEACTIVATED
}

enum CustomerApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// ─────────────────────────────── Tenancy / platform ───────────────────────────────

model PlatformUser {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  role         PlatformRole @default(PLATFORM_ADMIN)
  mfaEnabled   Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─────────────────────────────── Users / auth ───────────────────────────────

model User {
  id                 String    @id @default(cuid())
  // A1: phone is the primary identity (E.164, unique). Email is optional —
  // Postgres unique indexes allow many NULLs, so this stays a plain unique field.
  email              String?   @unique
  phone              String?   @unique
  phoneVerified      Boolean   @default(false)
  phoneVerifiedAt    DateTime?
  passwordHash       String
  name               String?
  role               String    @default("STORE_OWNER") // STORE_OWNER | PLATFORM_ADMIN | MANAGER | STAFF | SALES_AGENT
  mustChangePassword Boolean   @default(false) // v6: set by admin password reset — forces a password change on next login
  // Rice Ops M2: 4-digit PIN for quick login on staff phones (bcrypt hash, never the PIN).
  pinHash            String?
  pinFailedCount     Int       @default(0) // wrong PINs since the last success; 5 → locked
  pinLockedUntil     DateTime? // PIN login refused until this time (15 min lock)
  loginFailedCount   Int       @default(0) // Rice Ops M11: wrong passwords since the last success; 5 → locked
  loginLockedUntil   DateTime? // Rice Ops M11: password login refused until this time (15 min lock)
  tokenVersion       Int       @default(0) // bump to sign the user out everywhere (PIN reset, removal)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships        UserStore[]
  transfersRequested StockTransfer[]        @relation("TransferRequestedBy")
  transfersApproved  StockTransfer[]        @relation("TransferApprovedBy")
  passwordResets     PasswordResetHistory[]
  conversations      Conversation[]
}

model UserStore {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id])
  role      StoreRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  // Rice Ops M2: the location this person works at. Empty = every location.
  homeLocationId String?
  homeLocation   Warehouse? @relation("MemberHomeLocation", fields: [homeLocationId], references: [id], onDelete: SetNull)

  @@unique([userId, storeId])
}

// M7: roles × permissions deny matrix — a store row REMOVES a capability set from a role.
// Deny-only: `allowed=false` is the only persisted state; restoring = delete the row.
model RolePermission {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  role      String // StoreRole (tenant) vocabulary: OWNER/MANAGER/STAFF/SALES_AGENT/DELIVERY
  key       String // one of the TENANT_ROLES capability-set keys: ADMIN|VIEW|MANAGE|OWNER_MANAGER|DELIVERY
  allowed   Boolean  @default(false) // deny-only → always false; kept for explicit-history
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, role, key])
  @@index([storeId])
}

model Store {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  description  String?
  logoUrl      String? // image URL or small base64 (P8 allows base64/null)
  accentColor  String?     @default("#d94f2b") // P8: storefront accent
  bannerText   String? // P8: storefront banner message
  shareMessage String? // P8: default share text
  currencyCode String      @default("PHP") // operator decision 2026-09-01: Philippines → PHP
  timezone     String      @default("Asia/Manila") // operator decision 2026-09-01
  status       StoreStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  settings               StoreSettings?
  publicLink             PublicStoreLink?
  categories             Category[]
  products               Product[]
  stockLevels            StockLevel[]
  productImages          ProductImage[]
  productVariants        ProductVariant[] // P2a
  productAddons          ProductAddon[] // P2a
  productRelations       ProductRelation[] // P3d: related/upsell links
  deliveryZones          DeliveryZone[] // P5a: per-zone delivery pricing/ETA
  deliveryBookings       DeliveryBooking[] // P5b: courier bookings + COD remittances
  messengerPage          MessengerPage? // P6a
  messengerUsers         MessengerUser[] // P6a
  conversations          Conversation[] // P7: chatbot + agent conversations
  cannedReplies          CannedReply[] // P7: agent canned replies
  securityIncidents      SecurityIncident[] // P10: DPA/NPC incident hooks
  carts                  Cart[]
  orders                 Order[]
  storeCustomers         StoreCustomer[]
  memberships            StoreMembership[]
  statusHistory          StoreStatusHistory[]
  userStores             UserStore[]
  counters               StoreCounter[]
  auditLogs              AuditLog[]
  vouchers               Voucher[]
  loyaltyEntries         LoyaltyEntry[]
  registers              Register[] // N1: cash drawer registers (one per store today)
  registerSessions       RegisterSession[]
  cashMovements          CashMovement[]
  paymentMethods         PaymentMethod[] // N2: per-store tender methods
  notifications          NotificationLog[]
  warehouses             Warehouse[]
  locationPrices         LocationPrice[]
  kargadors              Kargador[]
  stockReturns           StockReturn[]
  resackJobs             ResackJob[]
  stockIns               StockIn[]
  smsMessages            SmsMessage[]
  stockCounts            StockCount[]
  stockWriteOffs         StockWriteOff[]
  dailyCloses            DailyClose[]
  signatures             Signature[]
  approvalRequests       ApprovalRequest[]
  flowDrafts             FlowDraft[]
  stockTransfers         StockTransfer[]
  payments               Payment[]
  creditEntries          CreditEntry[]
  expenses               Expense[]
  purchases              Purchase[]
  suppliers              Supplier[] // M6: vendor master per store
  rolePermissions        RolePermission[] // M7: roles × permissions deny matrix
  stockMovements         StockMovement[]
  stockConversions       StockConversion[]
  outboxEvents           OutboxEvent[]
  paymentStatusHistories PaymentStatusHistory[]
  campaigns              Campaign[]
  accounts               Account[]
  journalEntries         JournalEntry[]
}

model StoreSettings {
  id                        String         @id @default(cuid())
  storeId                   String         @unique
  store                     Store          @relation(fields: [storeId], references: [id])
  allowGuestOrders          Boolean        @default(true)
  requireCustomerApproval   Boolean        @default(false)
  orderingPaused            Boolean        @default(false)
  minOrderAmountMinor       Int            @default(0)
  orderCutoff               String? // e.g. "21:00" store-local; parsed by app
  maxOpenOrdersPerCustomer  Int            @default(10)
  deliveryEnabled           Boolean        @default(true)
  pickupEnabled             Boolean        @default(false)
  deliveryFeeMinor          Int            @default(0)
  creditLimitMinor          Int            @default(0) // store-wide utang limit (0 = credit disabled)
  creditTermDays            Int            @default(30) // V1: default dueAt offset for credit purchases
  costMode                  String         @default("SHARED") // SHARED = one cost per product; PER_LOCATION = each shelf has its own cost
  // Rice Ops M6: utang texts and reminders (the owner can switch them off).
  utangSmsEnabled           Boolean        @default(true)
  utangMonthlyReminder      Boolean        @default(true)
  utangOverdueReminder      Boolean        @default(true)
  utangOverdueDays          Int            @default(30)
  smsSenderName             String?
  receiptHeader             String? // P11: printed at top of receipts
  receiptFooter             String? // P11: printed at bottom
  showVatLabel              Boolean        @default(true) // P11: display-only VAT note (decision #2)
  // M4 tax engine. Defaults reproduce today's totals exactly: VAT is extracted for display and
  // the printed slip can hide it, so turning `vatEnabled` off is a true kill switch.
  vatEnabled                Boolean        @default(true) // compute + snapshot VAT
  vatRateBp                 Int            @default(1200) // basis points: 1200 = 12% PH VAT
  pricesIncludeVat          Boolean        @default(true) // catalogue prices already contain the VAT (decision #1)
  vatShowOnReceipt          Boolean        @default(true) // store owner may HIDE the VAT lines (decision #1b)
  tin                       String? // BIR taxpayer identification number, printed on the slip
  requireOpenShift          Boolean        @default(true) // N1: counter cash sales require an open register shift
  // P3b: statutory 20% discount for Senior Citizens & PWDs (RA 9994 / RA 10754)
  seniorPwdDiscountEnabled  Boolean        @default(false)
  dailySalesTargetMinor     Int            @default(0) // Overview: daily sales target (0 = off)
  hidePricePreOrder         Boolean        @default(false) // Hide per-product prices in Pre Orders screen
  closedStoreMessage        String?
  // P3g: Website→Messenger bridge — the store's connection state. Sends stay
  // SUPPRESSED (portal status) until a live provider is operator-approved; the
  // connected flag is the admin's recorded intent (real creds live in env, never DB).
  messengerConnected        Boolean        @default(false)
  messengerPageId           String?
  // P6a: linked Messenger page (token hash only, never the token).
  messengerPage             MessengerPage? @relation(fields: [messengerPageId], references: [id])
  // P3h: loyalty config — earn rate (pts per ₱1), one-time welcome bonus,
  // points expiry (months; 0 = never expires).
  loyaltyPointsPerPeso      Int            @default(1)
  loyaltyWelcomeBonusPoints Int            @default(0)
  loyaltyExpiryMonths       Int            @default(0)
  // P3i: order-number prefix — when set, numbers read PIN-YYYY-NNNNNN; null keeps the
  // legacy <SLUG>-NNNNNN format (backward compatible).
  orderNumberPrefix         String?
  // P10a: 0 = disabled; otherwise old Messenger conversation/message data is purgeable.
  privacyRetentionDays      Int            @default(0)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
}

model PublicStoreLink {
  id        String     @id @default(cuid())
  storeId   String     @unique
  store     Store      @relation(fields: [storeId], references: [id])
  slug      String     @unique // human-readable
  token     String     @unique // high-entropy, generated at app layer
  status    LinkStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  rotatedAt DateTime?
  revokedAt DateTime?
}

model StoreCounter {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
  kind    String // "ORDER_SEQ"
  value   Int    @default(0)

  @@unique([storeId, kind])
}

// ─────────────────────────────── Catalog ───────────────────────────────

model Category {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  slug      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([storeId, slug])
}

model Product {
  id                    String    @id @default(cuid())
  storeId               String
  store                 Store     @relation(fields: [storeId], references: [id])
  categoryId            String?
  category              Category? @relation(fields: [categoryId], references: [id])
  sku                   String
  name                  String
  description           String?
  barcode               String? // M5: scannable GTIN/EAN/UPC; store-scoped unique; POS search + labels
  unit                  String? // M5: display unit, e.g. "pc", "pack", "kilo", "bottle"
  soldByWeight          Boolean   @default(false) // M5: per-kilo item; decimal qty deferred (integer-only this module)
  stockBaseUnit         String? // e.g. g, ml, each; required with stockBaseQuantity for conversion
  stockBaseQuantity     Int? // content represented by one product stock unit in stockBaseUnit
  stockConversionFamily String? // only products in the same family may be converted into one another
  variety               String? // Rice Ops M4: e.g. "Sinandomeng"; empty = taken from the name ("Sinandomeng 25 kg")
  reviewStatus          ProductReviewStatus @default(ACTIVE) // Rice Ops M5: Bagong item stays FOR_REVIEW until the owner confirms or merges it
  createdById           String? // Rice Ops M5: who added it (manual items)
  mergedIntoId          String? // Rice Ops M5: the product a manual item was merged into
  priceMinor            Int // integer minor units; NEVER float
  trackStock            Boolean   @default(true) // false = sells at any time, no stock check and no stock movement ("not tracked")
  taxExempt             Boolean   @default(false) // M4: VAT-exempt line (e.g. basic goods / zero-rated)
  costMinor             Int       @default(0) // latest purchase cost (P5) — feeds COGS/profit (P10)
  isActive              Boolean   @default(true)
  // P3d: merchandising — featured flag + free-form display tags (store-scoped via the row).
  featured              Boolean   @default(false)
  tags                  String[]  @default([])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  images         ProductImage[]
  variants       ProductVariant[]
  addons         ProductAddon[]
  relationsFrom  ProductRelation[] @relation("ProductRelationSource")
  relationsTo    ProductRelation[] @relation("ProductRelationTarget")
  stockLevel     StockLevel?       @relation(fields: [stockLevelId], references: [id]) // legacy single-level (no warehouse); kept for backward compat
  stockLevels    StockLevel[]      @relation("ProductStockLevels")
  locationPrices LocationPrice[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  transfersFrom  StockTransfer[]
  stockReturns   StockReturn[]
  resacksIn      ResackJob[]
  resackOutputs  ResackOutput[]
  stockInLines   StockInLine[]
  countLines     StockCountLine[]
  writeOffs      StockWriteOff[]
  stockLevelId   String?

  @@unique([storeId, sku])
  @@unique([storeId, barcode]) // M5: scannable barcode unique per store
  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
}

model ProductImage {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id])
  productId String
  product   Product @relation(fields: [storeId, productId], references: [storeId, id]) // M3: tenant-consistent
  url       String
  sortOrder Int     @default(0)
}

// ─────────────────────────────── Variants (P2a) ───────────────────────────────
// A product may offer variants (size/color/…). Each variant has its OWN SKU, absolute
// price, and its OWN stock counters (onHand/reserved). Variant stock is reserved at
// checkout through the same atomic path (StockMovement rows carry variantId for audit).

model ProductVariant {
  id                String   @id @default(cuid())
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id])
  productId         String
  product           Product  @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  name              String
  sku               String
  priceMinor        Int // absolute price for this variant (server-authoritative)
  costMinor         Int      @default(0) // acquisition cost per variant stock unit
  stockBaseQuantity Int? // overrides Product.stockBaseQuantity; unit comes from parent Product
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([storeId, sku])
  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, productId])
}

// ─────────────────────────────── Add-ons / modifiers (P2a) ───────────────────────────────
// An add-on GROUP (e.g. "Extras") exposes OPTIONS ("Extra rice +₱20", "Side +₱35").
// A product may have several groups; the storefront renders checkboxes/radios.

model ProductAddon {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  productId String
  product   Product  @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  name      String
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options ProductAddonOption[]

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, productId])
}

model ProductAddonOption {
  id         String       @id @default(cuid())
  storeId    String
  addonId    String
  addon      ProductAddon @relation(fields: [storeId, addonId], references: [storeId, id], onDelete: Cascade)
  name       String
  priceMinor Int
  isActive   Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, addonId])
}

// ─────────────────────────────── Merchandising relations (P3d) ───────────────────────────────
// Related ("You may also like") and upsell ("Upgrade") links between products of the SAME
// store. Both composite FKs embed storeId, so a relation can only ever link same-store
// products (tenant integrity is database-enforced, matching M3).

model ProductRelation {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceProductId String
  sourceProduct   Product  @relation("ProductRelationSource", fields: [storeId, sourceProductId], references: [storeId, id], onDelete: Cascade)
  targetProductId String
  targetProduct   Product  @relation("ProductRelationTarget", fields: [storeId, targetProductId], references: [storeId, id], onDelete: Cascade)
  kind            String // "related" | "upsell"
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([storeId, sourceProductId, targetProductId, kind])
  @@index([storeId, sourceProductId, kind])
}

// ─────────────────────────────── Delivery zones (P5a) ───────────────────────────────
// Per-store delivery pricing by PH city (PSGC code) + optional barangay allowlist.
// A null cityCode is a catch-all "everywhere else" zone. When a store configures
// zones, delivery addresses that match nothing are OUT OF COVERAGE (rejected at
// checkout); no zones at all keeps the legacy flat StoreSettings.deliveryFeeMinor.

model DeliveryZone {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  cityCode      String? // PSGC city/municipality code; null = catch-all zone
  barangayCodes String[] // optional allowlist within the city (empty = whole city)
  feeMinor      Int
  etaMinutes    Int      @default(45)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([storeId, name])
  @@index([storeId, isActive])
}

// ─────────────────────────────── Courier bookings (P5b) ───────────────────────────────
// Third-party courier (Lalamove/GrabExpress/J&T — mocks) OR owner-run delivery.
// Tracks courier status via append-only DeliveryEvent rows; COD remittances are a
// ledger (what the courier collected vs. handed over, recorded by the owner).

model DeliveryBooking {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order    @relation(fields: [storeId, orderId], references: [storeId, id])
  courier        String // lalamove | grabexpress | jt | owner
  status         String   @default("created") // created|accepted|picked_up|delivered|failed|cancelled
  trackingNumber String?
  remoteId       String?
  codMinor       Int      @default(0) // cash the courier collects on delivery
  remittedMinor  Int      @default(0) // how much has been handed to the owner so far
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events      DeliveryEvent[]
  remittances CourierRemittance[]

  @@index([storeId, createdAt])
}

model DeliveryEvent {
  id        String          @id @default(cuid())
  storeId   String
  bookingId String
  booking   DeliveryBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime        @default(now())

  @@index([storeId, bookingId])
}

model CourierRemittance {
  id          String          @id @default(cuid())
  storeId     String
  bookingId   String
  booking     DeliveryBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountMinor Int
  note        String?
  recordedBy  String?
  createdAt   DateTime        @default(now())

  @@index([storeId, bookingId])
}

// ─────────────────────────────── Messenger connection (P6a) ───────────────────────────────
// The store's Messenger Page config + messenger user identities (PSID → customer).
// Only token HASHES are stored — never the page token or webhook verify token in
// plaintext. Live Graph/Send calls stay gated behind operator-approved credentials.

model MessengerPage {
  id                     String          @id @default(cuid())
  storeId                String          @unique
  store                  Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  pageId                 String
  pageName               String
  accessTokenHash        String // sha256 hex of the page token — never the token
  webhookVerifyTokenHash String? // for the GET handshake (PENDING_CREDENTIALS)
  connectedAt            DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  storeSettings          StoreSettings[]
}

model MessengerUser {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  psid       String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  optedIn    Boolean   @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([storeId, psid])
  @@index([storeId, optedIn])
}

// ─────────────────────────────── Chatbot conversations (P7) ───────────────────────────────
// A conversation per customer contact (Messenger PSID or web). The chatbot engine
// answers live-data-only; on low confidence it falls back to "I'll ask our staff"
// and the conversation awaits an agent (unreadCount). Agent replies flip mode to
// AGENT; every message carries the detected intent + confidence for the audit trail.

model Conversation {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  channel         String   @default("messenger") // messenger | web
  contactPsid     String? // messenger PSID
  customerId      String?
  status          String   @default("OPEN") // OPEN | AGENT | RESOLVED
  mode            String   @default("BOT") // BOT | AGENT | MIXED
  assignedAgentId String?
  assignedAgent   User?    @relation(fields: [assignedAgentId], references: [id])
  unreadCount     Int      @default(0)
  title           String?
  lastActivityAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages Message[]

  @@unique([storeId, contactPsid]) // one open thread per contact per store
  @@index([storeId, status, lastActivityAt])
}

model Message {
  id             String       @id @default(cuid())
  storeId        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String // customer | bot | agent
  senderId       String? // psid | agent user id | "bot"
  body           String
  intent         String? // detected intent (audit)
  confidence     Float? // 0..1 (audit)
  createdAt      DateTime     @default(now())

  @@index([storeId, conversationId, createdAt])
}

// ─────────────────────────────── Canned replies (P7) ───────────────────────────────
// Store-owned quick replies for agents. Seeded with defaults; CRUD-managed.

model CannedReply {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label     String
  body      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([storeId, label])
}

model SecurityIncident {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title      String
  severity   String // LOW | MEDIUM | HIGH | CRITICAL
  status     String    @default("OPEN") // OPEN | CONTAINED | RESOLVED
  details    Json?
  detectedAt DateTime  @default(now())
  notifiedAt DateTime?
  notifiedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([storeId, status, createdAt])
}

// ─────────────────────────────── CRM campaigns (P8) ───────────────────────────────
// A follow-up campaign targets a customer segment; running it evaluates the segment
// live and enqueues one `campaign.send` OutboxEvent per OPTED-IN Messenger user
// (suppressed until a live provider is approved). CampaignRecipient makes runs
// idempotent (never double-enqueues a customer).

model Campaign {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String
  rule           Json // { minOrders?, minLtvMinor?, maxDaysSinceLastOrder?, hasCredit?, tag? }
  message        String
  status         String    @default("DRAFT") // DRAFT | SENT
  sentAt         DateTime?
  recipientCount Int       @default(0)
  createdAt      DateTime  @default(now())

  recipients CampaignRecipient[]

  @@unique([storeId, name])
  @@index([storeId, status])
}

model CampaignRecipient {
  id              String        @id @default(cuid())
  storeId         String
  campaignId      String
  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  storeCustomerId String
  psid            String?
  sent            Boolean       @default(false)
  createdAt       DateTime      @default(now())
  storeCustomer   StoreCustomer @relation(fields: [storeCustomerId], references: [id])

  @@unique([storeId, campaignId, storeCustomerId])
  @@index([storeId, storeCustomerId])
}

// P9: ERP double-entry ledger — chart of accounts + balancing journal entries.
// Auto-posted from orders (sale + COGS), expenses, credit payments; every entry's
// debits equal its credits (enforced). Tenant-scoped.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id        String      @id @default(cuid())
  storeId   String
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code      String
  name      String
  type      AccountType
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  journalLines JournalEntryLine[]

  @@unique([storeId, code])
  @@unique([storeId, name])
}

model JournalEntry {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  entryDate DateTime
  reference String // order number / expense id / purchase id / manual
  memo      String?
  source    String   @default("manual") // sale | expense | credit_payment | manual
  createdBy String?
  createdAt DateTime @default(now())

  lines JournalEntryLine[]

  @@index([storeId, entryDate])
  @@index([storeId, source])
}

model JournalEntryLine {
  id          String       @id @default(cuid())
  storeId     String
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  debitMinor  Int          @default(0)
  creditMinor Int          @default(0)

  @@index([storeId, accountId])
}

// ─────────────────────────────── Warehouses / inventory ───────────────────────────────

// Rice Ops M1: a Warehouse row is a stock LOCATION of the business — a store
// counter (STORE) or the bulk warehouse (WAREHOUSE). The UI calls it "Location".
model Warehouse {
  id        String       @id @default(cuid())
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id])
  name      String
  isDefault Boolean      @default(false)
  type      LocationType @default(STORE) // M1: STORE counter or bulk WAREHOUSE
  code      String? // M1: short code shown everywhere (S1, S2, S3, WH)
  address   String? // M1: where the kargador goes
  isActive  Boolean      @default(true) // M1: inactive locations keep history but take no new stock
  needsReview Boolean    @default(false) // added by counter staff on the spot — the owner checks it
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  prices         LocationPrice[]
  members        UserStore[]       @relation("MemberHomeLocation")
  stockReturns   StockReturn[]
  resacks        ResackJob[]
  kargadors      Kargador[]
  signatures     Signature[]
  approvals      ApprovalRequest[]
  drafts         FlowDraft[]
  ordersSold     Order[]           @relation("OrderSellingLocation")
  registers      Register[]
  stockIns       StockIn[]
  payments       Payment[]
  stockCounts    StockCount[]
  writeOffs      StockWriteOff[]
  dailyCloses    DailyClose[]

  @@unique([storeId, name])
  @@unique([storeId, code])
}

enum LocationType {
  STORE
  WAREHOUSE
}

// M1: a location's own selling price for a product. No row = the product's main
// price. Cost is NOT here: one cost per product, the same at every location.
model LocationPrice {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  productId   String
  product     Product   @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  priceMinor  Int // integer centavos; per sack/pack, or per KILO for sold-by-weight items
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, productId, warehouseId])
  @@index([storeId, warehouseId])
}

enum TransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT // M3: released and signed at the source; on the road with the kargador
  COMPLETED
  CANCELLED
  RETURNING // M3: delivery refused or partial — the rest is coming back to the source
}

enum TransferKind {
  RESTOCK // location → location (Lipat)
  ORDER_RELEASE // a sale at one location served from another location's stock
}

model StockTransfer {
  id              String         @id @default(cuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id])
  fromWarehouseId String
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  quantity        Int
  status          TransferStatus @default(REQUESTED)
  requestedById   String
  requestedBy     User           @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  reason          String?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
  // ── Rice Ops M3: a numbered, signed trip ──
  docNumber       String? // TR-000123 (RESTOCK) / REL-000123 (ORDER_RELEASE)
  kind            TransferKind   @default(RESTOCK)
  orderId         String? // ORDER_RELEASE: the sale this release serves
  order           Order?         @relation(fields: [orderId], references: [id])
  kargadorId      String?
  kargador        Kargador?      @relation(fields: [kargadorId], references: [id])
  reservedQty     Int            @default(0) // held at the source from approval until release
  releasedQty     Int? // counted out at the source (Ilabas)
  receivedQty     Int? // counted in at the destination (Tanggapin)
  deliveredQty    Int? // ORDER_RELEASE: handed to the customer (Naihatid)
  returnedQty     Int? // counted back in at the source (Tanggapin pabalik)
  shortQty        Int            @default(0) // lost on the way (Kulang sa lipat)
  releasedAt      DateTime?
  releasedById    String?
  receivedAt      DateTime?
  receivedById    String?
  customerName    String? // ORDER_RELEASE: who the delivery is for
  deliveryNote    String?

  @@unique([storeId, docNumber])
  @@index([storeId, status])
  @@index([storeId, fromWarehouseId, status])
  @@index([storeId, toWarehouseId, status])
  @@index([storeId, orderId])
}

enum ReturnCondition {
  GOOD // back on the shelf
  DAMAGED // recorded, not sellable
}

// Rice Ops M3: Ibinalik — rice a customer brings back after a sale.
model StockReturn {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  docNumber   String
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id])
  locationId  String
  location    Warehouse       @relation(fields: [locationId], references: [id])
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  quantity    Int
  condition   ReturnCondition
  reason      String
  kargadorId  String?
  kargador    Kargador?       @relation(fields: [kargadorId], references: [id])
  createdById String
  createdAt   DateTime        @default(now())

  @@unique([storeId, docNumber])
  @@index([storeId, createdAt])
}

model StockLevel {
  id               String     @id @default(cuid())
  storeId          String
  store            Store      @relation(fields: [storeId], references: [id])
  productId        String
  product          Product    @relation("ProductStockLevels", fields: [storeId, productId], references: [storeId, id]) // M3: tenant-consistent
  warehouseId      String?
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  quantityOnHand   Int        @default(0)
  quantityReserved Int        @default(0)
  reorderThreshold Int        @default(0)
  costMinor        Int? // cost of the stock on THIS shelf; only used when the store counts cost per location (null = product cost)
  updatedAt        DateTime   @updatedAt
  products         Product[]

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  // Rice Ops M1: one row per product per location. Existing rows were merged and
  // given a location by the M1 migration; new code always sets warehouseId.
  // (Still nullable in the type only because older test fixtures create
  // location-less rows; Postgres treats NULLs as distinct in this key.)
  @@unique([storeId, productId, warehouseId])
  @@index([storeId, productId])
}

// ─────────────────────────────── Cart ───────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  storeId    String? // null until the first product binds the cart to a store
  store      Store?     @relation(fields: [storeId], references: [id])
  token      String     @unique // high-entropy guest cart token
  customerId String? // linked customer once accounts exist
  status     CartStatus @default(OPEN)
  expiresAt  DateTime? // soft-expiry: abandoned carts get released
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items CartItem[]
}

model CartItem {
  id               String   @id @default(cuid())
  cartId           String
  cart             Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  storeId          String
  productId        String
  product          Product  @relation(fields: [storeId, productId], references: [storeId, id]) // M3: tenant-consistent
  // P2a: line identity uses "" sentinel for "no variant / no add-ons" (Postgres unique
  // treats NULLs as distinct, so nullable columns would duplicate plain lines). The
  // variant FK is intentionally NOT database-enforced: sentinel "" can't reference a
  // variant, and tenant integrity is enforced at the app layer like the rest of the app.
  variantId        String   @default("")
  addonKey         String   @default("")
  addons           Json? // [{addonId, optionId, name, priceMinor}] line snapshot
  quantity         Int
  unitPriceMinor   Int // base unit price (VARIANT price when variantId set); add-on costs are separate below
  addonsTotalMinor Int      @default(0) // P2a: server-computed sum of selected add-on option prices
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([cartId, productId, variantId, addonKey])
  @@index([storeId])
}

// ─────────────────────────────── Notifications ───────────────────────────────

model NotificationLog {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  template  String
  channel   String // messenger | sms | email
  recipient String?
  text      String
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

// ─────────────────────────────── Payments / receipts ───────────────────────────────

model Payment {
  id                String           @id @default(cuid())
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id])
  storeId           String
  store             Store            @relation(fields: [storeId], references: [id])
  method            String // cash | credit | cod_collected | <payment-method code>
  amountMinor       Int
  changeMinor       Int              @default(0) // cash tendered change (cash sales)
  tenderedMinor     Int? // N2: cash handed over (changeMinor = tendered - applied)
  reference         String? // N2: e-wallet / bank reference
  idempotencyKey    String? // N2: replaying the same key never double-charges
  receivedAt        DateTime         @default(now())
  type              String           @default("payment") // payment | refund | void
  note              String?
  createdBy         String? // actor user id
  signatureData     String? // v4: finger-drawn signature (data-URL PNG) for utang collections
  signatureAt       DateTime? // v4: when the signature was captured
  // P4: online payments — gateway reference, hosted-checkout URL, proof, review trail.
  gateway           String? // "paymongo" | "bank_transfer" | null
  checkoutSessionId String? // gateway session reference
  checkoutUrl       String? // gateway-hosted checkout URL (customer pays there)
  status            String           @default("pending") // gateway lifecycle: pending|paid|reviewed|failed
  proofData         String? // bank-transfer proof (base64 image; validated size/type)
  proofMime         String? // image/png | image/jpeg
  reviewedAt        DateTime?
  reviewedBy        String?
  registerSessionId String? // N1: cash drawer shift this tender belongs to (null = off-counter)
  registerSession   RegisterSession? @relation(fields: [registerSessionId], references: [id])
  locationId        String? // Rice Ops M6: the location that took the money (Bayad sa utang at any store)
  location          Warehouse?       @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([storeId, receivedAt])
  @@index([orderId])
  @@index([registerSessionId])
  @@index([storeId, idempotencyKey])
}

// ─────────────────────────── Payment status history (P4) ───────────────────────────
// Append-only audit of order payment-status transitions (pending→received→reviewed→
// collected→refunded), tenant-scoped like every store-owned table.

model PaymentStatusHistory {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  orderId    String
  order      Order    @relation(fields: [storeId, orderId], references: [storeId, id])
  paymentId  String?
  fromStatus String
  toStatus   String
  reason     String?
  actorType  String? // gateway | admin | system
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([storeId, orderId, createdAt])
  @@index([storeId, paymentId])
}

// ─────────────────────────── Payment methods (N2) ───────────────────────────

enum PaymentMethodKind {
  CASH
  CREDIT
  EWALLET
  TRANSFER
  OTHER
}

/// A tender method this store accepts (cash, gcash, utang...). Seeded with sensible
/// defaults on first use; requiresReference forces an e-wallet / bank reference.
model PaymentMethod {
  id                String            @id @default(cuid())
  storeId           String
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code              String
  label             String
  kind              PaymentMethodKind @default(OTHER)
  requiresReference Boolean           @default(false)
  enabled           Boolean           @default(true)
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())

  @@unique([storeId, code])
  @@unique([storeId, id])
  @@index([storeId, enabled])
}

// ──────────────────────────── Cash drawer / shifts (N1) ────────────────────────────
// One physical drawer per store today (operator decision): a Register is the device,
// a RegisterSession is one cashier's shift on it. Balances are DERIVED from the
// append-only movement + payment rows — never stored as a mutable total.

enum RegisterStatus {
  ACTIVE
  INACTIVE
}

enum RegisterSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  FLOAT // opening float (recorded at open, informational)
  CASH_IN // cash added to the drawer (owner drop-in, change fund top-up)
  CASH_OUT // cash removed (bank drop, petty cash, expense paid from the drawer)
  REFUND // cash refunded to a customer
}

model Register {
  id        String            @id @default(cuid())
  storeId   String
  store     Store             @relation(fields: [storeId], references: [id])
  name      String            @default("Main counter")
  status    RegisterStatus    @default(ACTIVE)
  locationId String? // Rice Ops M5: each location keeps its own drawer
  location   Warehouse?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())
  sessions  RegisterSession[]

  @@unique([storeId, id]) // M3: composite target so children can be tenant-consistent
  @@index([storeId])
}

model RegisterSession {
  id                String                @id @default(cuid())
  storeId           String
  store             Store                 @relation(fields: [storeId], references: [id])
  registerId        String
  register          Register              @relation(fields: [storeId, registerId], references: [storeId, id])
  status            RegisterSessionStatus @default(OPEN)
  openedBy          String
  openedAt          DateTime              @default(now())
  openingFloatMinor Int                   @default(0)
  closedBy          String?
  closedAt          DateTime?
  countedMinor      Int? // cash the cashier counted at close
  expectedMinor     Int? // computed at close (opening float + cash in − cash out + cash sales − cash refunds)
  varianceMinor     Int? // countedMinor − expectedMinor (negative = short)
  notes             String?
  movements         CashMovement[]
  payments          Payment[] // N1: every tender recorded against this shift
  orders            Order[] // N1: counter sales opened during this shift

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, status])
  @@index([storeId, openedAt])
}

model CashMovement {
  id          String           @id @default(cuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id])
  sessionId   String
  session     RegisterSession  @relation(fields: [storeId, sessionId], references: [storeId, id])
  type        CashMovementType
  amountMinor Int // always POSITIVE; the type decides the sign
  reason      String?
  createdBy   String
  createdAt   DateTime         @default(now())

  @@index([storeId, sessionId, createdAt])
}

// ─────────────────────────────── Expenses ───────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  category    String // rent | utilities | supplies | wages | transport | other
  amountMinor Int
  note        String?
  spentAt     DateTime @default(now())
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([storeId, spentAt])
}

// ─────────────────────────────── Purchases / replenishment ───────────────────────────────

model Purchase {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  vendor         String?
  vendorId       String?
  supplier       Supplier? @relation(fields: [vendorId], references: [id])
  note           String?
  totalCostMinor Int       @default(0)
  purchasedAt    DateTime  @default(now())
  createdBy      String?
  createdAt      DateTime  @default(now())

  items PurchaseItem[]

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, purchasedAt])
}

model PurchaseItem {
  id            String   @id @default(cuid())
  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id])
  storeId       String
  productId     String
  product       Product  @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Restrict) // M3: tenant-consistent
  quantity      Int
  costMinor     Int
  lineCostMinor Int
}

// ─────────────────────────────── Suppliers ───────────────────────────────

model Supplier {
  id            String     @id @default(cuid())
  storeId       String
  store         Store      @relation(fields: [storeId], references: [id])
  name          String
  contactPerson String?
  phone         String?
  email         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases     Purchase[]

  @@unique([storeId, id])
  @@index([storeId, name])
}

// ─────────────────────────────── Loyalty ───────────────────────────────

enum LoyaltyEntryType {
  EARN
  REDEEM
  ADJUST // admin manual points adjust (+/-) with note
  WELCOME // one-time signup/welcome bonus (P3h)
  REVERSE // earned points clawed back on void/refund (P3h)
  EXPIRED // points removed by the expiry job (P3h)
}

model LoyaltyEntry {
  id              String           @id @default(cuid())
  storeId         String
  store           Store            @relation(fields: [storeId], references: [id])
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  storeCustomerId String
  storeCustomer   StoreCustomer    @relation(fields: [storeId, storeCustomerId], references: [storeId, id]) // M3: tenant-consistent
  type            LoyaltyEntryType
  points          Int // positive for EARN, negative for REDEEM
  balanceAfter    Int
  orderId         String?
  description     String
  createdAt       DateTime         @default(now())
  order           Order?           @relation(fields: [orderId], references: [id])

  @@index([storeCustomerId, createdAt])
}

// ─────────────────────────────── Orders ───────────────────────────────

// ─────────────────────────────── Vouchers / promotions ───────────────────────────────

model Voucher {
  id               String    @id @default(cuid())
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id])
  code             String // customer-facing, e.g. SAM10
  description      String?
  discountMinor    Int // flat discount in minor units (fixed-type vouchers)
  // P3a: voucher engine v2
  type             String    @default("fixed") // fixed | percent | free_delivery
  percentBp        Int? // percent vouchers: basis points (1000 = 10%)
  firstOrderOnly   Boolean   @default(false) // requires a customer account with no prior orders
  perCustomerLimit Int? // null = unlimited per customer
  scopeType        String    @default("all") // all | product | category
  scopeRefId       String? // productId or categoryId when scoped
  stackable        Boolean   @default(false) // may be combined with loyalty redemption at checkout
  minOrderMinor    Int       @default(0)
  maxRedemptions   Int? // null = unlimited
  usedCount        Int       @default(0) // M6: atomic counter guard for concurrent redemptions
  startsAt         DateTime?
  expiresAt        DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  redemptions VoucherRedemption[]

  @@unique([storeId, code])
  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, isActive])
}

model VoucherRedemption {
  id              String   @id @default(cuid())
  voucherId       String
  voucher         Voucher  @relation(fields: [storeId, voucherId], references: [storeId, id]) // M3: tenant-consistent
  storeId         String
  orderId         String? // null until redeemed at checkout
  order           Order?   @relation(fields: [orderId], references: [id])
  storeCustomerId String? // P3a: per-customer limit accounting (null = guest)
  createdAt       DateTime @default(now())

  @@unique([voucherId, orderId])
  @@index([storeId, createdAt])
  @@index([voucherId, storeCustomerId])
}

model Order {
  id                   String               @id @default(cuid())
  orderNumber          String               // store-scoped human-readable, e.g. SAMSTO-000001 (unique per store — M11)
  storeId              String
  store                Store                @relation(fields: [storeId], references: [id])
  status               OrderStatus          @default(RECEIVED)
  /// Guarded claim marker for the reservation lifecycle (single source of truth
  /// for "this order's reservation was already settled") — see OrderStockDisposition.
  stockDisposition     OrderStockDisposition?
  source               String               @default("online") // online | pos
  deliveryType         String               @default("delivery") // delivery | pickup (UI U5)
  fulfillmentType      OrderFulfillmentType @default(DELIVERY) // M3: explicit; backfilled from address
  currencyCode         String
  subtotalMinor        Int
  deliveryFeeMinor     Int                  @default(0)
  discountMinor        Int                  @default(0)
  totalMinor           Int
  snapshot             Json // immutable product names/SKUs/prices at purchase; catalog edits never change history
  // M4: immutable tax breakdown of this sale, frozen with the order like every other money field.
  vatableMinor         Int                  @default(0) // net-of-VAT base (prices inclusive) or pre-VAT base (exclusive)
  vatMinor             Int                  @default(0) // the VAT amount extracted/added
  vatExemptMinor       Int                  @default(0) // VAT-exempt sales in this order
  vatRateBp            Int                  @default(0) // the rate applied at the time of sale (0 = not taxed)
  paymentMethod        String               @default("cod")
  paymentStatus        PaymentStatus        @default(PENDING)
  idempotencyKey       String?              @unique // sha256 per apps/api/src/domain/idempotency.ts
  cartToken            String // bound for idempotent retries; mismatch on retry is rejected
  customerName         String
  customerPhone        String
  signatureData        String? // v4: finger-drawn signature (data-URL PNG) captured at utang finalize
  signatureAt          DateTime? // v4: when the signature was captured
  deliveryAddressLine1 String
  deliveryAddressLine2 String?
  landmark             String?
  deliverySchedule     String? // requested date/time window, free-form for slice
  // P1: PH address hierarchy — codes reference Ph* lookup tables; the NAMES are the
  // immutable snapshot frozen at checkout (nullable legacy free-text orders stay blank).
  deliveryRegionCode   String?
  deliveryProvinceCode String?
  deliveryCityCode     String?
  deliveryBarangayCode String?
  deliveryRegionName   String?
  deliveryProvinceName String?
  deliveryCityName     String?
  deliveryBarangayName String?
  // P5a: delivery zone snapshot (name + ETA) when the store prices by zone.
  deliveryZoneName     String?
  etaMinutes           Int?
  notes                String?
  // P3b: statutory 20% discount for Senior Citizens / PWDs — type, ID captured, name on card.
  statutoryType        String? // senior | pwd
  statutoryId          String?
  statutoryName        String?
  acknowledgedAt       DateTime?
  // Rice Ops M5: the location that sold it; a paper slip keeps its real time and number.
  sellingLocationId    String?
  sellingLocation      Warehouse?           @relation("OrderSellingLocation", fields: [sellingLocationId], references: [id], onDelete: Restrict)
  occurredAt           DateTime? // when it really happened (paper slip); null = createdAt
  paperSlipNo          String?
  encodedLater         Boolean              @default(false)
  // Rice Ops M7: agent orders — who took it, who approved it at the store (or why it was declined).
  agentUserId          String?
  approvedById         String?
  approvedAt           DateTime?
  declineReason        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  stockMovements         StockMovement[]
  stockTransfers         StockTransfer[] // Rice Ops M3: releases from other locations
  stockReturns           StockReturn[] // Rice Ops M3: Ibinalik
  redemptions            VoucherRedemption[]
  claimTokens            OrderClaimToken[]
  payments               Payment[]
  creditEntries          CreditEntry[]
  storeCustomerId        String? // linked customer account (optional, guests = null)
  storeCustomer          StoreCustomer?         @relation(fields: [storeCustomerId], references: [id])
  loyaltyEntries         LoyaltyEntry[]
  registerSessionId      String? // N1: the cash drawer shift this counter sale belongs to (null = online/off-counter)
  registerSession        RegisterSession?       @relation(fields: [registerSessionId], references: [id])
  paymentStatusHistories PaymentStatusHistory[]
  deliveryBookings       DeliveryBooking[]

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@unique([storeId, paperSlipNo]) // Rice Ops M5: a paper slip is encoded once
  @@unique([storeId, orderNumber]) // Rice Ops M11: two stores may pick the same prefix
  @@index([storeId, status, createdAt])
  @@index([storeId, sellingLocationId, createdAt])
  @@index([storeId, agentUserId, createdAt])
  @@index([storeId, source, status])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [storeId, orderId], references: [storeId, id]) // M3: tenant-consistent
  storeId        String
  productId      String? // kept as ref; name/sku/price are snapshot columns
  product        Product? @relation(fields: [productId], references: [id])
  // P2a: immutable variant + add-on snapshot (names/prices frozen with the sale)
  variantId      String?
  variantName    String?
  addons         Json?
  productName    String
  sku            String
  unitPriceMinor Int
  quantity       Int
  lineTotalMinor Int // unitPriceMinor * quantity (excludes add-on costs; the line total is on the Order totals)
  // Counter price override audit. The catalog price is authoritative by default;
  // these columns exist only when staff deliberately sold the line at another
  // price, so a receipt or an audit can explain it. Never set for online checkout.
  priceOverridden     Boolean   @default(false)
  priceOverrideReason String?
  priceOverriddenById String? // actor id (mirrors OrderStatusHistory.actorId)
  priceOverriddenAt   DateTime?
  catalogUnitPriceMinor Int? // the catalog/variant price the override deviated from
  // Rice Ops M5: loose rice. quantity = grams for a loose line; unitPriceMinor = per kilo.
  soldBy             String? // PIECE | KILO | PESO (null = legacy line)
  grams              Int?
  enteredAmountMinor Int? // by peso: what the customer asked for (= the line total)
  sourceLocationId   String? // served from another location (Kunin sa ibang tindahan)
  unitCostMinor      Int? // Rice Ops M9: cost frozen with the sale (per piece, or per kilo for loose rice)
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [storeId, orderId], references: [storeId, id]) // M3: tenant-consistent
  storeId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String? // required for manual overrides
  actorType  String // platform_admin | store_owner | staff | sales_agent | system
  actorId    String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model OrderClaimToken {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [storeId, orderId], references: [storeId, id]) // M3: tenant-consistent
  storeId   String
  token     String    @unique // single-use, HMAC-signed at app layer
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

// ─────────────────────────────── Customers / membership (roles) ───────────────────────────────

model Customer {
  id           String   @id @default(cuid())
  email        String?
  phone        String?
  passwordHash String?
  name         String?
  address      String? // v6: customer home/barangay address for delivery & records
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storeProfiles  StoreCustomer[] @relation("GlobalToStore")
  loyaltyEntries LoyaltyEntry[]
  consents       ConsentRecord[]
  messengerUsers MessengerUser[]

  @@unique([email, phone])
}

model StoreCustomer {
  id                   String                 @id @default(cuid())
  storeId              String
  store                Store                  @relation(fields: [storeId], references: [id])
  customerId           String
  customer             Customer               @relation("GlobalToStore", fields: [customerId], references: [id])
  approvalStatus       CustomerApprovalStatus @default(NOT_REQUIRED)
  loyaltyBalancePoints Int                    @default(0) // loyalty points balance (per-store)
  creditApproved       Boolean                @default(false) // approved for utang (P3)
  creditLimitMinor     Int                    @default(0) // per-customer credit limit (0 = store default)
  creditUnlimited      Boolean                @default(false) // approved for credit with NO limit (the default for a customer created on credit)
  creditBalanceMinor   Int                    @default(0) // open balance (positive = owes)
  // P8: CRM tags (free-form, e.g. ["vip", "bday"]) + campaign recipients.
  tags                 String[]               @default([])
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  orders             Order[]
  loyalty            LoyaltyEntry[]
  credit             CreditEntry[]
  smsMessages        SmsMessage[]
  addresses          StoreCustomerAddress[]
  campaignRecipients CampaignRecipient[]

  @@unique([storeId, customerId])
  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
}

model CreditEntry {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  storeCustomerId String
  storeCustomer   StoreCustomer @relation(fields: [storeId, storeCustomerId], references: [storeId, id]) // M3: tenant-consistent
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id])
  type            String // purchase | payment
  amountMinor     Int // signed: +purchase (debt), -payment (settle)
  startAt         DateTime      @default(now()) // V1: purchase date
  dueAt           DateTime? // V1: startAt + store creditTermDays (or manual)
  note            String?
  createdBy       String?
  paymentId       String? // Rice Ops M6: the Payment row behind a Bayad sa utang
  createdAt       DateTime      @default(now())

  @@index([storeId, storeCustomerId, createdAt])
}

model StoreStatusHistory {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  reason     String?
  changedBy  String? // actor user id (platform admin)
  createdAt  DateTime @default(now())

  @@index([storeId, createdAt])
}

// ─────────────────────────────── Customer saved addresses (P1.portal) ───────────────────────────────
// Tenant-scoped via the store profile. PH hierarchy codes + FROZEN name snapshots so
// later reference-data edits never rewrite a saved address's meaning. A store's customer
// owns ONLY their own addresses (isolated per store profile).

model StoreCustomerAddress {
  id              String        @id @default(cuid())
  storeId         String
  storeCustomerId String
  storeCustomer   StoreCustomer @relation(fields: [storeId, storeCustomerId], references: [storeId, id], onDelete: Cascade)
  label           String? // e.g. Home / Office / Store pickup
  addressLine1    String? // street / house no.
  addressLine2    String? // building / unit
  landmark        String?
  instructions    String?
  regionCode      String?
  provinceCode    String?
  cityCode        String?
  barangayCode    String?
  regionName      String?
  provinceName    String?
  cityName        String?
  barangayName    String?
  isDefault       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, storeCustomerId])
}

// ─────────────────────────────── DPA / privacy consent records (P1.portal) ───────────────────────────────
// RA 10173 (Data Privacy Act) — auditable, append-only capture of each consent grant.

model ConsentRecord {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  scope      String // e.g. "dpv1" (data privacy agreement)
  channel    String // web | messenger | pos | email | sms
  granted    Boolean  @default(true)
  version    String? // privacy-notice version, e.g. "2026.09"
  recordedBy String? // actor (customer id or staff id) — null = self-service
  createdAt  DateTime @default(now())

  @@index([customerId, scope])
}

model PasswordResetHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String   @default("")
  resetBy   String? // acting admin/owner id
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model StoreMembership {
  id             String           @id @default(cuid())
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id])
  platformUserId String? // set on acceptance
  email          String
  displayName    String
  role           StoreRole
  status         MembershipStatus @default(PENDING)
  invitedAt      DateTime         @default(now())
  acceptedAt     DateTime?
  deactivatedAt  DateTime?

  @@unique([storeId, email])
}

// ─────────────────────────────── Audit ───────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  storeId    String? // null = platform-level event
  store      Store?   @relation(fields: [storeId], references: [id])
  actorType  String // platform_admin | store_owner | staff | sales_agent | system | customer
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([storeId, entityType, entityId, createdAt])
}

// ─────────────────────────────── M3: integrity foundation ───────────────────────────────
// Append-only stock MOVEMENT audit — every reservation/release/consume/adjust/
// receipt/transfer that changes a StockLevel. The balances are derived facts;
// this ledger is the source for reconciliation (Module 4 consumes + writes it).
model StockMovement {
  id           String           @id @default(cuid())
  storeId      String
  store        Store            @relation(fields: [storeId], references: [id])
  productId    String
  product      Product          @relation(fields: [storeId, productId], references: [storeId, id])
  variantId    String? // P2a: variant-level movements (null = product-level)
  warehouseId  String?
  warehouse    Warehouse?       @relation(fields: [warehouseId], references: [id])
  delta        Int // signed: +receipt/-sale/-reserve/+release/+adjust ...
  type         String // RESERVE | RELEASE | CONSUME | ADJUST | RECEIPT | TRANSFER_IN | TRANSFER_OUT | VOID_RESTORE
  orderId      String?
  order        Order?           @relation(fields: [orderId], references: [id])
  conversionId String?
  conversion   StockConversion? @relation(fields: [conversionId], references: [id], onDelete: SetNull)
  note         String?
  createdBy    String?
  balanceAfter Int? // stock-level balance after applying this movement (reconcilable)
  documentType String? // Rice Ops M1: the document behind this move (TRANSFER, SALE, RESACK, COUNT, …)
  documentId   String? // Rice Ops M1: that document's id, so every number traces back
  createdAt    DateTime         @default(now())

  @@unique([storeId, id]) // composite target for future child refs
  @@index([storeId, documentType, documentId])
  @@index([storeId, conversionId])
  @@index([storeId, productId, createdAt])
  @@index([storeId, type, createdAt])
  @@index([storeId, warehouseId, createdAt]) // Rice Ops M9: reports by location and time
}

// One atomic repack/transform operation (source decrement + output increment).
// BASE amounts are integer grams, milliliters, or eaches; actual yield and any
// unaccounted remainder are recorded for audit and cost allocation.
model StockConversion {
  id                      String          @id @default(cuid())
  storeId                 String
  store                   Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceProductId         String
  sourceVariantId         String?
  destinationProductId    String
  destinationVariantId    String?
  warehouseId             String?
  sourceQuantity          Int
  outputQuantity          Int
  stockBaseUnit           String
  conversionFamily        String
  sourceBaseQuantity      Int
  destinationBaseQuantity Int
  wasteBaseQuantity       Int             @default(0)
  sourceValueMinor        Int             @default(0)
  outputValueMinor        Int             @default(0)
  wasteValueMinor         Int             @default(0)
  reason                  String
  wasteReason             String?
  createdBy               String
  idempotencyKey          String          @unique
  sourceBalanceAfter      Int             @default(0)
  outputBalanceAfter      Int             @default(0)
  createdAt               DateTime        @default(now())
  movements               StockMovement[]

  @@unique([storeId, id])
  @@index([storeId, createdAt])
}

// Transactional OUTBOX for external side effects (notifications etc.).
// Written in the SAME transaction as the authoritative state change; a worker
// (Module 9) processes PENDING rows to PROCESSED/FAILED with retries. Never
// call an external provider synchronously inside a commerce command.
model OutboxEvent {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])
  aggregateType String // order | payment | customer | ...
  aggregateId   String
  eventType     String // order.received | order.updated | notification.send | ...
  payload       Json
  status        String    @default("PENDING") // PENDING | PROCESSED | FAILED
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}

// ─────────────────────────────── P1: PH address reference hierarchy ───────────────────────────────
// Platform REFERENCE data — NOT store-owned, so no storeId. Codes are PSGC-style
// stable identifiers. The seed ships a curated subset (Metro Manila + demo provinces);
// the full PSGC 42k-barangay dataset is PENDING. Order rows snapshot the NAMES.
// "type" on PhCity is "city" | "municipality".

model PhRegion {
  id        String       @id @default(cuid())
  code      String       @unique // PSGC-style region code
  name      String
  sortOrder Int          @default(0)
  provinces PhProvince[]

  @@map("PhRegion")
}

model PhProvince {
  id       String   @id @default(cuid())
  code     String   @unique // PSGC-style province code
  regionId String
  region   PhRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name     String
  cities   PhCity[]

  @@index([regionId])
  @@map("PhProvince")
}

model PhCity {
  id         String       @id @default(cuid())
  code       String       @unique // PSGC-style city/municipality code
  provinceId String
  province   PhProvince   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name       String
  type       String // city | municipality
  barangays  PhBarangay[]

  @@index([provinceId])
  @@map("PhCity")
}

model PhBarangay {
  id     String @id @default(cuid())
  code   String @unique // PSGC-style barangay code
  cityId String
  city   PhCity @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name   String

  @@index([cityId])
  @@map("PhBarangay")
}

// ─────────────────────────── Rice Ops M2: people, signatures, approvals ───────────────────────────

// A kargador carries and repacks rice. Not a login account: they sign on staff phones.
model Kargador {
  id             String     @id @default(cuid())
  storeId        String
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  photoUrl       String?
  homeLocationId String?
  homeLocation   Warehouse? @relation(fields: [homeLocationId], references: [id], onDelete: SetNull)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  signatures Signature[]
  transfers  StockTransfer[]
  returns    StockReturn[]
  resacks    ResackJob[]

  @@unique([storeId, name])
  @@index([storeId, isActive])
}

enum SignerKind {
  STAFF
  KARGADOR
  CUSTOMER
  SLIP_PHOTO
}

// Insert-only (a DB trigger refuses UPDATE). One row per person signing one step of one document.
model Signature {
  id           String     @id @default(cuid())
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  documentType String // TRANSFER, RELEASE, RESACK, COUNT, WRITE_OFF, ORDER, CLOSE…
  documentId   String
  step         String // RELEASE, RECEIVE, FINISH, SUBMIT…
  signerKind   SignerKind
  signerUserId String? // STAFF: the logged-in person who signed
  kargadorId   String?
  kargador     Kargador?  @relation(fields: [kargadorId], references: [id], onDelete: NoAction)
  signerName   String // name as shown at signing time (kept even if the person is renamed)
  imagePng     String // data:image/png;base64,…
  imageSha256  String
  locationId   String?
  location     Warehouse? @relation(fields: [locationId], references: [id], onDelete: NoAction) // a location with signatures cannot be deleted (deactivate it)
  capturedById String // whose phone/session captured it
  createdAt    DateTime   @default(now())

  @@index([storeId, documentType, documentId])
  @@index([storeId, kargadorId, createdAt])
  @@index([storeId, createdAt])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

// "Para sa iyo" — one owner inbox for anything that needs a yes/no.
model ApprovalRequest {
  id            String         @id @default(cuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind          String // LOSS_OVER_TOLERANCE, UTANG_OVER_LIMIT, MANUAL_ITEM, WRITE_OFF, VOID, TRANSFER
  documentType  String
  documentId    String
  locationId    String?
  location      Warehouse?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  summary       String // one Taglish sentence, shown as-is
  detail        Json?
  approverRoles String[]       @default(["OWNER"]) // who may decide
  status        ApprovalStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([storeId, status, createdAt])
  @@index([storeId, documentType, documentId])
}

enum DraftStatus {
  OPEN
  DONE
  CANCELLED
}

// "Tapusin" — a flow saved at every step so another phone can finish it.
model FlowDraft {
  id          String      @id @default(cuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  flow        String // RELEASE, RECEIVE, RESACK, COUNT, SALE…
  locationId  String?
  location    Warehouse?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  docNumber   String?
  step        Int         @default(1)
  data        Json
  status      DraftStatus @default(OPEN)
  version     Int         @default(1)
  createdById String
  updatedById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([storeId, status, locationId])
}

// ─────────────────────────── Rice Ops M4: resack ───────────────────────────

enum ResackStatus {
  STARTED // Simulan: the input is off the shelf ("nasa resack")
  FINISHED // Tapusin: outputs on the shelf, loss recorded
  CANCELLED // stopped before finishing: the input went back
}

// Any rice into any rice at one location. Weighed in grams; the outputs carry the
// input's cost (split by weight); a loss over 1% is the owner's call (Para sa iyo).
model ResackJob {
  id              String         @id @default(cuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  docNumber       String // RSK-000123
  locationId      String
  location        Warehouse      @relation(fields: [locationId], references: [id])
  inputProductId  String
  inputProduct    Product        @relation(fields: [inputProductId], references: [id])
  inputQty        Int
  inputGrams      Int
  inputValueMinor Int // input cost at the time (qty × cost)
  outputGrams     Int?
  lossGrams       Int?
  lossBp          Int? // basis points (100 = 1%)
  lossValueMinor  Int?
  varietyChange   Boolean        @default(false) // Ibang klase
  openSack        Boolean        @default(false) // Buksan ang sako (sack → loose)
  status          ResackStatus   @default(STARTED)
  kargadorId      String?
  kargador        Kargador?      @relation(fields: [kargadorId], references: [id])
  approvalId      String? // loss over tolerance → ApprovalRequest
  note            String?
  startedById     String
  startedAt       DateTime       @default(now())
  finishedById    String?
  finishedAt      DateTime?
  cancelReason    String?
  outputs         ResackOutput[]

  @@unique([storeId, docNumber])
  @@index([storeId, status, locationId])
  @@index([storeId, startedAt])
}

model ResackOutput {
  id         String    @id @default(cuid())
  storeId    String
  jobId      String
  job        ResackJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  quantity   Int // stock units of the output product (grams for loose rice)
  grams      Int
  valueMinor Int // the input cost carried into this output

  @@index([storeId, jobId])
}

// ─────────────── Rice Ops M5: selling ───────────────

enum ProductReviewStatus {
  ACTIVE
  FOR_REVIEW // Bagong item: sells now, the owner reviews it later
  MERGED // merged into another product (kept for history)
}

// Manual na pasok: stock in without a purchase order, signed by the receiver.
model StockIn {
  id           String        @id @default(cuid())
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  docNumber    String // IN-000001
  locationId   String
  location     Warehouse     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  supplierName String?
  note         String?
  createdById  String
  createdAt    DateTime      @default(now())
  lines        StockInLine[]

  @@unique([storeId, docNumber])
  @@index([storeId, locationId, createdAt])
}

model StockInLine {
  id            String  @id @default(cuid())
  storeId       String
  stockInId     String
  stockIn       StockIn @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int // sacks, or grams for loose rice
  unitCostMinor Int?

  @@index([storeId, stockInId])
}

// ─────────────── Rice Ops M6: utang texts ───────────────

enum SmsStatus {
  QUEUED
  SENT
  FAILED // shows "Hindi naipadala" with Ipadala ulit
  SKIPPED // no valid mobile number / texts switched off
  OPENED // the phone's own SMS app was opened with the text ready — never claimed as sent
}

// Every utang text: what was sent, to whom, and whether it went. A failed text never
// blocks the sale or payment behind it.
model SmsMessage {
  id                String         @id @default(cuid())
  storeId           String
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeCustomerId   String?
  storeCustomer     StoreCustomer? @relation(fields: [storeCustomerId], references: [id], onDelete: SetNull)
  phone             String? // E.164
  template          String // utang_sale | utang_payment | utang_monthly | utang_overdue
  text              String
  status            SmsStatus      @default(QUEUED)
  provider          String? // mock | semaphore
  providerMessageId String?
  attempts          Int            @default(0)
  lastError         String?
  documentType      String?
  documentId        String?
  periodKey         String? // reminders: one per customer per period
  createdById       String?
  createdAt         DateTime       @default(now())
  sentAt            DateTime?

  @@unique([storeId, storeCustomerId, template, periodKey])
  @@index([storeId, createdAt])
  @@index([storeId, storeCustomerId, createdAt])
  @@index([storeId, status])
}

// ─────────────── Rice Ops M8: counts and write-offs ───────────────

enum CountKind {
  FULL // the owner's count of every item at a location
  PARTIAL // the owner's count of chosen items
  QUICK // the zero check: "May natira pa ba?" — posts at once
  CLOSING // the top-5 quick count at closing — posts at once
}

enum CountStatus {
  OPEN
  SUBMITTED // waiting for the owner (FULL / PARTIAL)
  APPROVED // adjustments posted (Bilang CNT-…)
  CANCELLED
}

model StockCount {
  id               String           @id @default(cuid())
  storeId          String
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  docNumber        String // CNT-000045
  locationId       String
  location         Warehouse        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  kind             CountKind
  status           CountStatus      @default(OPEN)
  blind            Boolean          @default(true)
  note             String?
  startedById      String
  startedAt        DateTime         @default(now())
  submittedById    String?
  submittedAt      DateTime?
  decidedById      String?
  decidedAt        DateTime?
  approvalId       String?
  kulangValueMinor Int              @default(0)
  sobraValueMinor  Int              @default(0)
  lines            StockCountLine[]

  @@unique([storeId, docNumber])
  @@index([storeId, locationId, status])
  @@index([storeId, startedAt])
}

model StockCountLine {
  id                 String     @id @default(cuid())
  storeId            String
  countId            String
  count              StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId          String
  product            Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  expectedQty        Int? // the system's number when this line was counted (hidden on a blind count)
  countedQty         Int?
  countedAt          DateTime?
  countedById        String?
  varianceQty        Int?
  varianceValueMinor Int?
  postedQty          Int? // the COUNT_ADJUST posted

  @@unique([countId, productId])
  @@index([storeId, productId, countedAt])
}

enum WriteOffReason {
  TAPON // spilled
  BASA // wet
  BUKBOK // weevils
  SAMPLE
  BIGAY // giveaway
  IBA // other (reason required)
}

model StockWriteOff {
  id          String         @id @default(cuid())
  storeId     String
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  docNumber   String // WO-000001
  locationId  String
  location    Warehouse      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  reason      WriteOffReason
  note        String?
  valueMinor  Int
  lossBp      Int
  approvalId  String?
  createdById String
  createdAt   DateTime       @default(now())

  @@unique([storeId, docNumber])
  @@index([storeId, locationId, createdAt])
}

// ─────────────── Rice Ops M9: Pagsasara (closing) ───────────────

// One per location per business day: the frozen totals the owner reads that evening,
// cash expected vs counted, and the closing signature. The day's report locks to it.
model DailyClose {
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  locationId        String
  location          Warehouse @relation(fields: [locationId], references: [id], onDelete: Restrict)
  businessDate      String // YYYY-MM-DD (Manila)
  totals            Json
  cashExpectedMinor Int
  cashCountedMinor  Int
  cashVarianceMinor Int
  closingCountId    String?
  note              String?
  closedById        String
  closedAt          DateTime  @default(now())

  @@unique([storeId, locationId, businessDate])
  @@index([storeId, businessDate])
}

// ─────────────── Rice Ops M10: weak signal ───────────────

// The first answer to a signed step, by the phone's Idempotency-Key — a step queued
// offline and sent twice (or sent after it already reached the server) happens once.
model IdempotencyRecord {
  id             String    @id @default(cuid())
  keyHash        String    @unique // sha256(user + store + route + key); the raw key is never stored
  userId         String
  route          String
  status         String    @default("IN_PROGRESS") // IN_PROGRESS | DONE
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([createdAt])
}

// Cost and price history. Plain ids (no relations) so old data and deletes never block it.
model PriceHistory {
  id          String   @id @default(cuid())
  storeId     String
  productId   String
  warehouseId String? // set when a per-location cost or price changed
  field       String // COST or PRICE
  oldMinor    Int
  newMinor    Int
  source      String   @default("MANUAL") // MANUAL, PURCHASE, CONVERSION, LOCATION
  reason      String?
  changedById String?
  createdAt   DateTime @default(now())

  @@index([storeId, productId, createdAt])
}
