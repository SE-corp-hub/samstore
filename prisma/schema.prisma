// SAM STORE — Prisma schema (Thin Slice + roles/tenancy day one)
// Rule from AGENTS.md: EVERY store-owned table carries store_id.
// Money is stored as integer minor units (cents) — never floats.
// Naming: camelCase fields (Prisma), no @map; revisit with a dedicated mapping pass.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum StoreStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  CLOSED
}

enum LinkStatus {
  ACTIVE
  REVOKED
  ROTATED
}

// M3: explicit fulfillment — replaces address inference (backfilled; the app
// writes it at order creation; reads switch in Module 8).
enum OrderFulfillmentType {
  PICKUP
  DELIVERY
}

enum CartStatus {
  OPEN
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  ON_HOLD // POS held order (V1) — goods earmarked, resume/edit/complete later
  COMPLETED // counter/POS sale — terminal, payment captured at completion
  CANCELLED
  FAILED_DELIVERY
}

enum PaymentStatus {
  PENDING // COD: awaiting collection at delivery
  RECEIVED // P4: gateway notification or bank-transfer proof received (awaiting review)
  COLLECTED // COD: collected
  REVIEWED // P4: operator reviewed the proof / gateway payment confirmed
  CANCELLED_REFUND // unused in slice; reserved
  REFUNDED // P4: fully refunded
  FAILED // P4: gateway payment failed
}

enum PlatformRole {
  PLATFORM_ADMIN
}

enum StoreRole {
  OWNER
  MANAGER
  STAFF
  SALES_AGENT
  DELIVERY // P12: courier — sees OUT_FOR_DELIVERY orders only; no admin surfaces
}

enum MembershipStatus {
  PENDING
  ACTIVE
  DEACTIVATED
}

enum CustomerApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// ─────────────────────────────── Tenancy / platform ───────────────────────────────

model PlatformUser {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  role         PlatformRole @default(PLATFORM_ADMIN)
  mfaEnabled   Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─────────────────────────────── Users / auth ───────────────────────────────

model User {
  id                 String    @id @default(cuid())
  // A1: phone is the primary identity (E.164, unique). Email is optional —
  // Postgres unique indexes allow many NULLs, so this stays a plain unique field.
  email              String?   @unique
  phone              String?   @unique
  phoneVerified      Boolean   @default(false)
  phoneVerifiedAt    DateTime?
  passwordHash       String
  name               String?
  role               String    @default("STORE_OWNER") // STORE_OWNER | PLATFORM_ADMIN | MANAGER | STAFF | SALES_AGENT
  mustChangePassword Boolean   @default(false) // v6: set by admin password reset — forces a password change on next login
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships        UserStore[]
  transfersRequested StockTransfer[]        @relation("TransferRequestedBy")
  transfersApproved  StockTransfer[]        @relation("TransferApprovedBy")
  passwordResets     PasswordResetHistory[]
}

model UserStore {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id])
  role      StoreRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  @@unique([userId, storeId])
}

// M7: roles × permissions deny matrix — a store row REMOVES a capability set from a role.
// Deny-only: `allowed=false` is the only persisted state; restoring = delete the row.
model RolePermission {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  role      String // StoreRole (tenant) vocabulary: OWNER/MANAGER/STAFF/SALES_AGENT/DELIVERY
  key       String // one of the TENANT_ROLES capability-set keys: ADMIN|VIEW|MANAGE|OWNER_MANAGER|DELIVERY
  allowed   Boolean  @default(false) // deny-only → always false; kept for explicit-history
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, role, key])
  @@index([storeId])
}

model Store {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  description  String?
  logoUrl      String? // image URL or small base64 (P8 allows base64/null)
  accentColor  String?     @default("#d94f2b") // P8: storefront accent
  bannerText   String? // P8: storefront banner message
  shareMessage String? // P8: default share text
  currencyCode String      @default("PHP") // operator decision 2026-09-01: Philippines → PHP
  timezone     String      @default("Asia/Manila") // operator decision 2026-09-01
  status       StoreStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  settings               StoreSettings?
  publicLink             PublicStoreLink?
  categories             Category[]
  products               Product[]
  stockLevels            StockLevel[]
  productImages          ProductImage[]
  productVariants        ProductVariant[] // P2a
  productAddons          ProductAddon[] // P2a
  productRelations       ProductRelation[] // P3d: related/upsell links
  deliveryZones          DeliveryZone[] // P5a: per-zone delivery pricing/ETA
  deliveryBookings       DeliveryBooking[] // P5b: courier bookings + COD remittances
  carts                  Cart[]
  orders                 Order[]
  storeCustomers         StoreCustomer[]
  memberships            StoreMembership[]
  statusHistory          StoreStatusHistory[]
  userStores             UserStore[]
  counters               StoreCounter[]
  auditLogs              AuditLog[]
  vouchers               Voucher[]
  loyaltyEntries         LoyaltyEntry[]
  registers              Register[] // N1: cash drawer registers (one per store today)
  registerSessions       RegisterSession[]
  cashMovements          CashMovement[]
  paymentMethods         PaymentMethod[] // N2: per-store tender methods
  notifications          NotificationLog[]
  warehouses             Warehouse[]
  stockTransfers         StockTransfer[]
  payments               Payment[]
  creditEntries          CreditEntry[]
  expenses               Expense[]
  purchases              Purchase[]
  suppliers              Supplier[] // M6: vendor master per store
  rolePermissions        RolePermission[] // M7: roles × permissions deny matrix
  stockMovements         StockMovement[]
  outboxEvents           OutboxEvent[]
  paymentStatusHistories PaymentStatusHistory[]
}

model StoreSettings {
  id                        String   @id @default(cuid())
  storeId                   String   @unique
  store                     Store    @relation(fields: [storeId], references: [id])
  allowGuestOrders          Boolean  @default(true)
  requireCustomerApproval   Boolean  @default(false)
  orderingPaused            Boolean  @default(false)
  minOrderAmountMinor       Int      @default(0)
  orderCutoff               String? // e.g. "21:00" store-local; parsed by app
  maxOpenOrdersPerCustomer  Int      @default(10)
  deliveryEnabled           Boolean  @default(true)
  pickupEnabled             Boolean  @default(false)
  deliveryFeeMinor          Int      @default(0)
  creditLimitMinor          Int      @default(0) // store-wide utang limit (0 = credit disabled)
  creditTermDays            Int      @default(30) // V1: default dueAt offset for credit purchases
  receiptHeader             String? // P11: printed at top of receipts
  receiptFooter             String? // P11: printed at bottom
  showVatLabel              Boolean  @default(true) // P11: display-only VAT note (decision #2)
  // M4 tax engine. Defaults reproduce today's totals exactly: VAT is extracted for display and
  // the printed slip can hide it, so turning `vatEnabled` off is a true kill switch.
  vatEnabled                Boolean  @default(true) // compute + snapshot VAT
  vatRateBp                 Int      @default(1200) // basis points: 1200 = 12% PH VAT
  pricesIncludeVat          Boolean  @default(true) // catalogue prices already contain the VAT (decision #1)
  vatShowOnReceipt          Boolean  @default(true) // store owner may HIDE the VAT lines (decision #1b)
  tin                       String? // BIR taxpayer identification number, printed on the slip
  requireOpenShift          Boolean  @default(true) // N1: counter cash sales require an open register shift
  // P3b: statutory 20% discount for Senior Citizens & PWDs (RA 9994 / RA 10754)
  seniorPwdDiscountEnabled  Boolean  @default(false)
  dailySalesTargetMinor     Int      @default(0) // Overview: daily sales target (0 = off)
  hidePricePreOrder         Boolean  @default(false) // Hide per-product prices in Pre Orders screen
  closedStoreMessage        String?
  // P3g: Website→Messenger bridge — the store's connection state. Sends stay
  // SUPPRESSED (portal status) until a live provider is operator-approved; the
  // connected flag is the admin's recorded intent (real creds live in env, never DB).
  messengerConnected        Boolean  @default(false)
  messengerPageId           String?
  // P3h: loyalty config — earn rate (pts per ₱1), one-time welcome bonus,
  // points expiry (months; 0 = never expires).
  loyaltyPointsPerPeso      Int      @default(1)
  loyaltyWelcomeBonusPoints Int      @default(0)
  loyaltyExpiryMonths       Int      @default(0)
  // P3i: order-number prefix — when set, numbers read PIN-YYYY-NNNNNN; null keeps the
  // legacy <SLUG>-NNNNNN format (backward compatible).
  orderNumberPrefix         String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model PublicStoreLink {
  id        String     @id @default(cuid())
  storeId   String     @unique
  store     Store      @relation(fields: [storeId], references: [id])
  slug      String     @unique // human-readable
  token     String     @unique // high-entropy, generated at app layer
  status    LinkStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  rotatedAt DateTime?
  revokedAt DateTime?
}

model StoreCounter {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
  kind    String // "ORDER_SEQ"
  value   Int    @default(0)

  @@unique([storeId, kind])
}

// ─────────────────────────────── Catalog ───────────────────────────────

model Category {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  slug      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([storeId, slug])
}

model Product {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id])
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  sku          String
  name         String
  description  String?
  barcode      String? // M5: scannable GTIN/EAN/UPC; store-scoped unique; POS search + labels
  unit         String? // M5: display unit, e.g. "pc", "pack", "kilo", "bottle"
  soldByWeight Boolean   @default(false) // M5: per-kilo item; decimal qty deferred (integer-only this module)
  priceMinor   Int // integer minor units; NEVER float
  taxExempt    Boolean   @default(false) // M4: VAT-exempt line (e.g. basic goods / zero-rated)
  costMinor    Int       @default(0) // latest purchase cost (P5) — feeds COGS/profit (P10)
  isActive     Boolean   @default(true)
  // P3d: merchandising — featured flag + free-form display tags (store-scoped via the row).
  featured     Boolean   @default(false)
  tags         String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  images         ProductImage[]
  variants       ProductVariant[]
  addons         ProductAddon[]
  relationsFrom  ProductRelation[] @relation("ProductRelationSource")
  relationsTo    ProductRelation[] @relation("ProductRelationTarget")
  stockLevel     StockLevel?       @relation(fields: [stockLevelId], references: [id]) // legacy single-level (no warehouse); kept for backward compat
  stockLevels    StockLevel[]      @relation("ProductStockLevels")
  cartItems      CartItem[]
  orderItems     OrderItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  transfersFrom  StockTransfer[]
  stockLevelId   String?

  @@unique([storeId, sku])
  @@unique([storeId, barcode]) // M5: scannable barcode unique per store
  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
}

model ProductImage {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id])
  productId String
  product   Product @relation(fields: [storeId, productId], references: [storeId, id]) // M3: tenant-consistent
  url       String
  sortOrder Int     @default(0)
}

// ─────────────────────────────── Variants (P2a) ───────────────────────────────
// A product may offer variants (size/color/…). Each variant has its OWN SKU, absolute
// price, and its OWN stock counters (onHand/reserved). Variant stock is reserved at
// checkout through the same atomic path (StockMovement rows carry variantId for audit).

model ProductVariant {
  id               String   @id @default(cuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id])
  productId        String
  product          Product  @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  name             String
  sku              String
  priceMinor       Int // absolute price for this variant (server-authoritative)
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([storeId, sku])
  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, productId])
}

// ─────────────────────────────── Add-ons / modifiers (P2a) ───────────────────────────────
// An add-on GROUP (e.g. "Extras") exposes OPTIONS ("Extra rice +₱20", "Side +₱35").
// A product may have several groups; the storefront renders checkboxes/radios.

model ProductAddon {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  productId String
  product   Product  @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  name      String
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options ProductAddonOption[]

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, productId])
}

model ProductAddonOption {
  id         String       @id @default(cuid())
  storeId    String
  addonId    String
  addon      ProductAddon @relation(fields: [storeId, addonId], references: [storeId, id], onDelete: Cascade)
  name       String
  priceMinor Int
  isActive   Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, addonId])
}

// ─────────────────────────────── Merchandising relations (P3d) ───────────────────────────────
// Related ("You may also like") and upsell ("Upgrade") links between products of the SAME
// store. Both composite FKs embed storeId, so a relation can only ever link same-store
// products (tenant integrity is database-enforced, matching M3).

model ProductRelation {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceProductId String
  sourceProduct   Product  @relation("ProductRelationSource", fields: [storeId, sourceProductId], references: [storeId, id], onDelete: Cascade)
  targetProductId String
  targetProduct   Product  @relation("ProductRelationTarget", fields: [storeId, targetProductId], references: [storeId, id], onDelete: Cascade)
  kind            String // "related" | "upsell"
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([storeId, sourceProductId, targetProductId, kind])
  @@index([storeId, sourceProductId, kind])
}

// ─────────────────────────────── Delivery zones (P5a) ───────────────────────────────
// Per-store delivery pricing by PH city (PSGC code) + optional barangay allowlist.
// A null cityCode is a catch-all "everywhere else" zone. When a store configures
// zones, delivery addresses that match nothing are OUT OF COVERAGE (rejected at
// checkout); no zones at all keeps the legacy flat StoreSettings.deliveryFeeMinor.

model DeliveryZone {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  cityCode      String? // PSGC city/municipality code; null = catch-all zone
  barangayCodes String[] // optional allowlist within the city (empty = whole city)
  feeMinor      Int
  etaMinutes    Int      @default(45)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([storeId, name])
  @@index([storeId, isActive])
}

// ─────────────────────────────── Courier bookings (P5b) ───────────────────────────────
// Third-party courier (Lalamove/GrabExpress/J&T — mocks) OR owner-run delivery.
// Tracks courier status via append-only DeliveryEvent rows; COD remittances are a
// ledger (what the courier collected vs. handed over, recorded by the owner).

model DeliveryBooking {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order    @relation(fields: [storeId, orderId], references: [storeId, id])
  courier        String // lalamove | grabexpress | jt | owner
  status         String   @default("created") // created|accepted|picked_up|delivered|failed|cancelled
  trackingNumber String?
  remoteId       String?
  codMinor       Int      @default(0) // cash the courier collects on delivery
  remittedMinor  Int      @default(0) // how much has been handed to the owner so far
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events      DeliveryEvent[]
  remittances CourierRemittance[]

  @@index([storeId, createdAt])
}

model DeliveryEvent {
  id        String          @id @default(cuid())
  storeId   String
  bookingId String
  booking   DeliveryBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime        @default(now())

  @@index([storeId, bookingId])
}

model CourierRemittance {
  id          String          @id @default(cuid())
  storeId     String
  bookingId   String
  booking     DeliveryBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountMinor Int
  note        String?
  recordedBy  String?
  createdAt   DateTime        @default(now())

  @@index([storeId, bookingId])
}

// ─────────────────────────────── Warehouses / inventory ───────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")

  @@unique([storeId, name])
}

enum TransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id              String         @id @default(cuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id])
  fromWarehouseId String
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  quantity        Int
  status          TransferStatus @default(REQUESTED)
  requestedById   String
  requestedBy     User           @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  reason          String?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?

  @@index([storeId, status])
}

model StockLevel {
  id               String     @id @default(cuid())
  storeId          String
  store            Store      @relation(fields: [storeId], references: [id])
  productId        String
  product          Product    @relation("ProductStockLevels", fields: [storeId, productId], references: [storeId, id]) // M3: tenant-consistent
  warehouseId      String?
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  quantityOnHand   Int        @default(0)
  quantityReserved Int        @default(0)
  reorderThreshold Int        @default(0)
  updatedAt        DateTime   @updatedAt
  products         Product[]

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, productId])
}

// ─────────────────────────────── Cart ───────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  storeId    String? // null until the first product binds the cart to a store
  store      Store?     @relation(fields: [storeId], references: [id])
  token      String     @unique // high-entropy guest cart token
  customerId String? // linked customer once accounts exist
  status     CartStatus @default(OPEN)
  expiresAt  DateTime? // soft-expiry: abandoned carts get released
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items CartItem[]
}

model CartItem {
  id               String   @id @default(cuid())
  cartId           String
  cart             Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  storeId          String
  productId        String
  product          Product  @relation(fields: [storeId, productId], references: [storeId, id]) // M3: tenant-consistent
  // P2a: line identity uses "" sentinel for "no variant / no add-ons" (Postgres unique
  // treats NULLs as distinct, so nullable columns would duplicate plain lines). The
  // variant FK is intentionally NOT database-enforced: sentinel "" can't reference a
  // variant, and tenant integrity is enforced at the app layer like the rest of the app.
  variantId        String   @default("")
  addonKey         String   @default("")
  addons           Json? // [{addonId, optionId, name, priceMinor}] line snapshot
  quantity         Int
  unitPriceMinor   Int // base unit price (VARIANT price when variantId set); add-on costs are separate below
  addonsTotalMinor Int      @default(0) // P2a: server-computed sum of selected add-on option prices
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([cartId, productId, variantId, addonKey])
  @@index([storeId])
}

// ─────────────────────────────── Notifications ───────────────────────────────

model NotificationLog {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  template  String
  channel   String // messenger | sms | email
  recipient String?
  text      String
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

// ─────────────────────────────── Payments / receipts ───────────────────────────────

model Payment {
  id                String           @id @default(cuid())
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id])
  storeId           String
  store             Store            @relation(fields: [storeId], references: [id])
  method            String // cash | credit | cod_collected | <payment-method code>
  amountMinor       Int
  changeMinor       Int              @default(0) // cash tendered change (cash sales)
  tenderedMinor     Int? // N2: cash handed over (changeMinor = tendered - applied)
  reference         String? // N2: e-wallet / bank reference
  idempotencyKey    String? // N2: replaying the same key never double-charges
  receivedAt        DateTime         @default(now())
  type              String           @default("payment") // payment | refund | void
  note              String?
  createdBy         String? // actor user id
  signatureData     String? // v4: finger-drawn signature (data-URL PNG) for utang collections
  signatureAt       DateTime? // v4: when the signature was captured
  // P4: online payments — gateway reference, hosted-checkout URL, proof, review trail.
  gateway           String? // "paymongo" | "bank_transfer" | null
  checkoutSessionId String? // gateway session reference
  checkoutUrl       String? // gateway-hosted checkout URL (customer pays there)
  status            String           @default("pending") // gateway lifecycle: pending|paid|reviewed|failed
  proofData         String? // bank-transfer proof (base64 image; validated size/type)
  proofMime         String? // image/png | image/jpeg
  reviewedAt        DateTime?
  reviewedBy        String?
  registerSessionId String? // N1: cash drawer shift this tender belongs to (null = off-counter)
  registerSession   RegisterSession? @relation(fields: [registerSessionId], references: [id])

  @@index([storeId, receivedAt])
  @@index([orderId])
  @@index([registerSessionId])
  @@index([storeId, idempotencyKey])
}

// ─────────────────────────── Payment status history (P4) ───────────────────────────
// Append-only audit of order payment-status transitions (pending→received→reviewed→
// collected→refunded), tenant-scoped like every store-owned table.

model PaymentStatusHistory {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  orderId    String
  order      Order    @relation(fields: [storeId, orderId], references: [storeId, id])
  paymentId  String?
  fromStatus String
  toStatus   String
  reason     String?
  actorType  String? // gateway | admin | system
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([storeId, orderId, createdAt])
  @@index([storeId, paymentId])
}

// ─────────────────────────── Payment methods (N2) ───────────────────────────

enum PaymentMethodKind {
  CASH
  CREDIT
  EWALLET
  TRANSFER
  OTHER
}

/// A tender method this store accepts (cash, gcash, utang...). Seeded with sensible
/// defaults on first use; requiresReference forces an e-wallet / bank reference.
model PaymentMethod {
  id                String            @id @default(cuid())
  storeId           String
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code              String
  label             String
  kind              PaymentMethodKind @default(OTHER)
  requiresReference Boolean           @default(false)
  enabled           Boolean           @default(true)
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())

  @@unique([storeId, code])
  @@unique([storeId, id])
  @@index([storeId, enabled])
}

// ──────────────────────────── Cash drawer / shifts (N1) ────────────────────────────
// One physical drawer per store today (operator decision): a Register is the device,
// a RegisterSession is one cashier's shift on it. Balances are DERIVED from the
// append-only movement + payment rows — never stored as a mutable total.

enum RegisterStatus {
  ACTIVE
  INACTIVE
}

enum RegisterSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  FLOAT // opening float (recorded at open, informational)
  CASH_IN // cash added to the drawer (owner drop-in, change fund top-up)
  CASH_OUT // cash removed (bank drop, petty cash, expense paid from the drawer)
  REFUND // cash refunded to a customer
}

model Register {
  id        String            @id @default(cuid())
  storeId   String
  store     Store             @relation(fields: [storeId], references: [id])
  name      String            @default("Main counter")
  status    RegisterStatus    @default(ACTIVE)
  createdAt DateTime          @default(now())
  sessions  RegisterSession[]

  @@unique([storeId, id]) // M3: composite target so children can be tenant-consistent
  @@index([storeId])
}

model RegisterSession {
  id                String                @id @default(cuid())
  storeId           String
  store             Store                 @relation(fields: [storeId], references: [id])
  registerId        String
  register          Register              @relation(fields: [storeId, registerId], references: [storeId, id])
  status            RegisterSessionStatus @default(OPEN)
  openedBy          String
  openedAt          DateTime              @default(now())
  openingFloatMinor Int                   @default(0)
  closedBy          String?
  closedAt          DateTime?
  countedMinor      Int? // cash the cashier counted at close
  expectedMinor     Int? // computed at close (opening float + cash in − cash out + cash sales − cash refunds)
  varianceMinor     Int? // countedMinor − expectedMinor (negative = short)
  notes             String?
  movements         CashMovement[]
  payments          Payment[] // N1: every tender recorded against this shift
  orders            Order[] // N1: counter sales opened during this shift

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, status])
  @@index([storeId, openedAt])
}

model CashMovement {
  id          String           @id @default(cuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id])
  sessionId   String
  session     RegisterSession  @relation(fields: [storeId, sessionId], references: [storeId, id])
  type        CashMovementType
  amountMinor Int // always POSITIVE; the type decides the sign
  reason      String?
  createdBy   String
  createdAt   DateTime         @default(now())

  @@index([storeId, sessionId, createdAt])
}

// ─────────────────────────────── Expenses ───────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  category    String // rent | utilities | supplies | wages | transport | other
  amountMinor Int
  note        String?
  spentAt     DateTime @default(now())
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([storeId, spentAt])
}

// ─────────────────────────────── Purchases / replenishment ───────────────────────────────

model Purchase {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  vendor         String?
  vendorId       String?
  supplier       Supplier? @relation(fields: [vendorId], references: [id])
  note           String?
  totalCostMinor Int       @default(0)
  purchasedAt    DateTime  @default(now())
  createdBy      String?
  createdAt      DateTime  @default(now())

  items PurchaseItem[]

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, purchasedAt])
}

model PurchaseItem {
  id            String   @id @default(cuid())
  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id])
  storeId       String
  productId     String
  product       Product  @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Restrict) // M3: tenant-consistent
  quantity      Int
  costMinor     Int
  lineCostMinor Int
}

// ─────────────────────────────── Suppliers ───────────────────────────────

model Supplier {
  id            String     @id @default(cuid())
  storeId       String
  store         Store      @relation(fields: [storeId], references: [id])
  name          String
  contactPerson String?
  phone         String?
  email         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases     Purchase[]

  @@unique([storeId, id])
  @@index([storeId, name])
}

// ─────────────────────────────── Loyalty ───────────────────────────────

enum LoyaltyEntryType {
  EARN
  REDEEM
  ADJUST // admin manual points adjust (+/-) with note
  WELCOME // one-time signup/welcome bonus (P3h)
  REVERSE // earned points clawed back on void/refund (P3h)
  EXPIRED // points removed by the expiry job (P3h)
}

model LoyaltyEntry {
  id              String           @id @default(cuid())
  storeId         String
  store           Store            @relation(fields: [storeId], references: [id])
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  storeCustomerId String
  storeCustomer   StoreCustomer    @relation(fields: [storeId, storeCustomerId], references: [storeId, id]) // M3: tenant-consistent
  type            LoyaltyEntryType
  points          Int // positive for EARN, negative for REDEEM
  balanceAfter    Int
  orderId         String?
  description     String
  createdAt       DateTime         @default(now())
  order           Order?           @relation(fields: [orderId], references: [id])

  @@index([storeCustomerId, createdAt])
}

// ─────────────────────────────── Orders ───────────────────────────────

// ─────────────────────────────── Vouchers / promotions ───────────────────────────────

model Voucher {
  id               String    @id @default(cuid())
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id])
  code             String // customer-facing, e.g. SAM10
  description      String?
  discountMinor    Int // flat discount in minor units (fixed-type vouchers)
  // P3a: voucher engine v2
  type             String    @default("fixed") // fixed | percent | free_delivery
  percentBp        Int? // percent vouchers: basis points (1000 = 10%)
  firstOrderOnly   Boolean   @default(false) // requires a customer account with no prior orders
  perCustomerLimit Int? // null = unlimited per customer
  scopeType        String    @default("all") // all | product | category
  scopeRefId       String? // productId or categoryId when scoped
  stackable        Boolean   @default(false) // may be combined with loyalty redemption at checkout
  minOrderMinor    Int       @default(0)
  maxRedemptions   Int? // null = unlimited
  usedCount        Int       @default(0) // M6: atomic counter guard for concurrent redemptions
  startsAt         DateTime?
  expiresAt        DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  redemptions VoucherRedemption[]

  @@unique([storeId, code])
  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, isActive])
}

model VoucherRedemption {
  id              String   @id @default(cuid())
  voucherId       String
  voucher         Voucher  @relation(fields: [storeId, voucherId], references: [storeId, id]) // M3: tenant-consistent
  storeId         String
  orderId         String? // null until redeemed at checkout
  order           Order?   @relation(fields: [orderId], references: [id])
  storeCustomerId String? // P3a: per-customer limit accounting (null = guest)
  createdAt       DateTime @default(now())

  @@unique([voucherId, orderId])
  @@index([storeId, createdAt])
  @@index([voucherId, storeCustomerId])
}

model Order {
  id                   String               @id @default(cuid())
  orderNumber          String               @unique // store-scoped human-readable, e.g. SAMSTO-000001
  storeId              String
  store                Store                @relation(fields: [storeId], references: [id])
  status               OrderStatus          @default(RECEIVED)
  source               String               @default("online") // online | pos
  deliveryType         String               @default("delivery") // delivery | pickup (UI U5)
  fulfillmentType      OrderFulfillmentType @default(DELIVERY) // M3: explicit; backfilled from address
  currencyCode         String
  subtotalMinor        Int
  deliveryFeeMinor     Int                  @default(0)
  discountMinor        Int                  @default(0)
  totalMinor           Int
  snapshot             Json // immutable product names/SKUs/prices at purchase; catalog edits never change history
  // M4: immutable tax breakdown of this sale, frozen with the order like every other money field.
  vatableMinor         Int                  @default(0) // net-of-VAT base (prices inclusive) or pre-VAT base (exclusive)
  vatMinor             Int                  @default(0) // the VAT amount extracted/added
  vatExemptMinor       Int                  @default(0) // VAT-exempt sales in this order
  vatRateBp            Int                  @default(0) // the rate applied at the time of sale (0 = not taxed)
  paymentMethod        String               @default("cod")
  paymentStatus        PaymentStatus        @default(PENDING)
  idempotencyKey       String?              @unique // sha256 per apps/api/src/domain/idempotency.ts
  cartToken            String // bound for idempotent retries; mismatch on retry is rejected
  customerName         String
  customerPhone        String
  signatureData        String? // v4: finger-drawn signature (data-URL PNG) captured at utang finalize
  signatureAt          DateTime? // v4: when the signature was captured
  deliveryAddressLine1 String
  deliveryAddressLine2 String?
  landmark             String?
  deliverySchedule     String? // requested date/time window, free-form for slice
  // P1: PH address hierarchy — codes reference Ph* lookup tables; the NAMES are the
  // immutable snapshot frozen at checkout (nullable legacy free-text orders stay blank).
  deliveryRegionCode   String?
  deliveryProvinceCode String?
  deliveryCityCode     String?
  deliveryBarangayCode String?
  deliveryRegionName   String?
  deliveryProvinceName String?
  deliveryCityName     String?
  deliveryBarangayName String?
  // P5a: delivery zone snapshot (name + ETA) when the store prices by zone.
  deliveryZoneName     String?
  etaMinutes           Int?
  notes                String?
  // P3b: statutory 20% discount for Senior Citizens / PWDs — type, ID captured, name on card.
  statutoryType        String? // senior | pwd
  statutoryId          String?
  statutoryName        String?
  acknowledgedAt       DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  stockMovements         StockMovement[]
  redemptions            VoucherRedemption[]
  claimTokens            OrderClaimToken[]
  payments               Payment[]
  creditEntries          CreditEntry[]
  storeCustomerId        String? // linked customer account (optional, guests = null)
  storeCustomer          StoreCustomer?         @relation(fields: [storeCustomerId], references: [id])
  loyaltyEntries         LoyaltyEntry[]
  registerSessionId      String? // N1: the cash drawer shift this counter sale belongs to (null = online/off-counter)
  registerSession        RegisterSession?       @relation(fields: [registerSessionId], references: [id])
  paymentStatusHistories PaymentStatusHistory[]
  deliveryBookings       DeliveryBooking[]

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, status, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [storeId, orderId], references: [storeId, id]) // M3: tenant-consistent
  storeId        String
  productId      String? // kept as ref; name/sku/price are snapshot columns
  product        Product? @relation(fields: [productId], references: [id])
  // P2a: immutable variant + add-on snapshot (names/prices frozen with the sale)
  variantId      String?
  variantName    String?
  addons         Json?
  productName    String
  sku            String
  unitPriceMinor Int
  quantity       Int
  lineTotalMinor Int // unitPriceMinor * quantity (excludes add-on costs; add-on total is on the Order totals)
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [storeId, orderId], references: [storeId, id]) // M3: tenant-consistent
  storeId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String? // required for manual overrides
  actorType  String // platform_admin | store_owner | staff | sales_agent | system
  actorId    String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model OrderClaimToken {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [storeId, orderId], references: [storeId, id]) // M3: tenant-consistent
  storeId   String
  token     String    @unique // single-use, HMAC-signed at app layer
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

// ─────────────────────────────── Customers / membership (roles) ───────────────────────────────

model Customer {
  id           String   @id @default(cuid())
  email        String?
  phone        String?
  passwordHash String?
  name         String?
  address      String? // v6: customer home/barangay address for delivery & records
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storeProfiles  StoreCustomer[] @relation("GlobalToStore")
  loyaltyEntries LoyaltyEntry[]
  consents       ConsentRecord[]

  @@unique([email, phone])
}

model StoreCustomer {
  id                   String                 @id @default(cuid())
  storeId              String
  store                Store                  @relation(fields: [storeId], references: [id])
  customerId           String
  customer             Customer               @relation("GlobalToStore", fields: [customerId], references: [id])
  approvalStatus       CustomerApprovalStatus @default(NOT_REQUIRED)
  loyaltyBalancePoints Int                    @default(0) // loyalty points balance (per-store)
  creditApproved       Boolean                @default(false) // approved for utang (P3)
  creditLimitMinor     Int                    @default(0) // per-customer credit limit (0 = store default)
  creditBalanceMinor   Int                    @default(0) // open balance (positive = owes)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  orders    Order[]
  loyalty   LoyaltyEntry[]
  credit    CreditEntry[]
  addresses StoreCustomerAddress[]

  @@unique([storeId, customerId])
  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
}

model CreditEntry {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  storeCustomerId String
  storeCustomer   StoreCustomer @relation(fields: [storeId, storeCustomerId], references: [storeId, id]) // M3: tenant-consistent
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id])
  type            String // purchase | payment
  amountMinor     Int // signed: +purchase (debt), -payment (settle)
  startAt         DateTime      @default(now()) // V1: purchase date
  dueAt           DateTime? // V1: startAt + store creditTermDays (or manual)
  note            String?
  createdBy       String?
  createdAt       DateTime      @default(now())

  @@index([storeId, storeCustomerId, createdAt])
}

model StoreStatusHistory {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  reason     String?
  changedBy  String? // actor user id (platform admin)
  createdAt  DateTime @default(now())

  @@index([storeId, createdAt])
}

// ─────────────────────────────── Customer saved addresses (P1.portal) ───────────────────────────────
// Tenant-scoped via the store profile. PH hierarchy codes + FROZEN name snapshots so
// later reference-data edits never rewrite a saved address's meaning. A store's customer
// owns ONLY their own addresses (isolated per store profile).

model StoreCustomerAddress {
  id              String        @id @default(cuid())
  storeId         String
  storeCustomerId String
  storeCustomer   StoreCustomer @relation(fields: [storeId, storeCustomerId], references: [storeId, id], onDelete: Cascade)
  label           String? // e.g. Home / Office / Store pickup
  addressLine1    String? // street / house no.
  addressLine2    String? // building / unit
  landmark        String?
  instructions    String?
  regionCode      String?
  provinceCode    String?
  cityCode        String?
  barangayCode    String?
  regionName      String?
  provinceName    String?
  cityName        String?
  barangayName    String?
  isDefault       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([storeId, id]) // M3: composite target for tenant-consistent children
  @@index([storeId, storeCustomerId])
}

// ─────────────────────────────── DPA / privacy consent records (P1.portal) ───────────────────────────────
// RA 10173 (Data Privacy Act) — auditable, append-only capture of each consent grant.

model ConsentRecord {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  scope      String // e.g. "dpv1" (data privacy agreement)
  channel    String // web | messenger | pos | email | sms
  granted    Boolean  @default(true)
  version    String? // privacy-notice version, e.g. "2026.09"
  recordedBy String? // actor (customer id or staff id) — null = self-service
  createdAt  DateTime @default(now())

  @@index([customerId, scope])
}

model PasswordResetHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String   @default("")
  resetBy   String? // acting admin/owner id
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model StoreMembership {
  id             String           @id @default(cuid())
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id])
  platformUserId String? // set on acceptance
  email          String
  displayName    String
  role           StoreRole
  status         MembershipStatus @default(PENDING)
  invitedAt      DateTime         @default(now())
  acceptedAt     DateTime?
  deactivatedAt  DateTime?

  @@unique([storeId, email])
}

// ─────────────────────────────── Audit ───────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  storeId    String? // null = platform-level event
  store      Store?   @relation(fields: [storeId], references: [id])
  actorType  String // platform_admin | store_owner | staff | sales_agent | system | customer
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([storeId, entityType, entityId, createdAt])
}

// ─────────────────────────────── M3: integrity foundation ───────────────────────────────
// Append-only stock MOVEMENT audit — every reservation/release/consume/adjust/
// receipt/transfer that changes a StockLevel. The balances are derived facts;
// this ledger is the source for reconciliation (Module 4 consumes + writes it).
model StockMovement {
  id           String     @id @default(cuid())
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id])
  productId    String
  product      Product    @relation(fields: [storeId, productId], references: [storeId, id])
  variantId    String? // P2a: variant-level movements (null = product-level)
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  delta        Int // signed: +receipt/-sale/-reserve/+release/+adjust ...
  type         String // RESERVE | RELEASE | CONSUME | ADJUST | RECEIPT | TRANSFER_IN | TRANSFER_OUT | VOID_RESTORE
  orderId      String?
  order        Order?     @relation(fields: [orderId], references: [id])
  note         String?
  createdBy    String?
  balanceAfter Int? // stock-level balance after applying this movement (reconcilable)
  createdAt    DateTime   @default(now())

  @@unique([storeId, id]) // composite target for future child refs
  @@index([storeId, productId, createdAt])
  @@index([storeId, type, createdAt])
}

// Transactional OUTBOX for external side effects (notifications etc.).
// Written in the SAME transaction as the authoritative state change; a worker
// (Module 9) processes PENDING rows to PROCESSED/FAILED with retries. Never
// call an external provider synchronously inside a commerce command.
model OutboxEvent {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])
  aggregateType String // order | payment | customer | ...
  aggregateId   String
  eventType     String // order.received | order.updated | notification.send | ...
  payload       Json
  status        String    @default("PENDING") // PENDING | PROCESSED | FAILED
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}

// ─────────────────────────────── P1: PH address reference hierarchy ───────────────────────────────
// Platform REFERENCE data — NOT store-owned, so no storeId. Codes are PSGC-style
// stable identifiers. The seed ships a curated subset (Metro Manila + demo provinces);
// the full PSGC 42k-barangay dataset is PENDING. Order rows snapshot the NAMES.
// "type" on PhCity is "city" | "municipality".

model PhRegion {
  id        String       @id @default(cuid())
  code      String       @unique // PSGC-style region code
  name      String
  sortOrder Int          @default(0)
  provinces PhProvince[]

  @@map("PhRegion")
}

model PhProvince {
  id       String   @id @default(cuid())
  code     String   @unique // PSGC-style province code
  regionId String
  region   PhRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name     String
  cities   PhCity[]

  @@index([regionId])
  @@map("PhProvince")
}

model PhCity {
  id         String       @id @default(cuid())
  code       String       @unique // PSGC-style city/municipality code
  provinceId String
  province   PhProvince   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name       String
  type       String // city | municipality
  barangays  PhBarangay[]

  @@index([provinceId])
  @@map("PhCity")
}

model PhBarangay {
  id     String @id @default(cuid())
  code   String @unique // PSGC-style barangay code
  cityId String
  city   PhCity @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name   String

  @@index([cityId])
  @@map("PhBarangay")
}
