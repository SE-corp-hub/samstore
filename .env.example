# SAM STORE — environment template (copy to .env, never commit)
# All values are placeholders. Redact everything in reports.

# Managed cloud Postgres (Neon/Supabase). Required for migrations + runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sam_store?sslmode=require"

# Managed cloud Redis (Upstash). Recommended for rate limiting + shared TTL cache
# across API instances. When unset/empty, the app falls back to in-process maps
# (per-process only — fine for a single instance).
REDIS_URL="rediss://default:PASSWORD@HOST:6379"

# HMAC secret for signing single-use order-claim tokens (min 32 chars).
CLAIM_SIGNING_SECRET="replace-with-32-plus-random-chars"

# Session cookies for admin/storefront.
SESSION_SECRET="replace-with-32-plus-random-chars"

# Bcrypt cost for auth hashing (default 12).
BCRYPT_ROUNDS=12

# JWT signing secret (min 32 chars) — REQUIRED in production.
JWT_SECRET="replace-with-32-plus-random-chars"

# Rice Ops M11: the web app's address(es) allowed to call the API from a browser,
# comma-separated. Required in production (https only). In development
# http://localhost:3000 is always allowed; add your PC's LAN address here to test
# from a phone, e.g. http://192.168.1.10:3000
CORS_ORIGINS=""

# Rice Ops M11: owner sign-up at /auth/register is closed. The platform admin creates
# stores and owners; owners add their own staff. Set to "true" only to reopen it.
ALLOW_OWNER_SIGNUP="false"
